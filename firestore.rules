rules_version = '2';

// ════════════════════════════════════════════════════════════════════════
//  Akademîya Aram Tîgran — Firestore Security Rules  (v5: rol ayrımı + en az yetki)
//  ----------------------------------------------------------------------
//  YAZMA: rol bazlı kilitli (önceki sürümle aynı).
//  OKUMA: artık varsayılan KAPALI.
//    • Öğrenci: yalnızca KENDİ students dokümanını okur (no == e-posta öneki).
//      Diğer öğrencileri ve öğretmen listesini (PII + şifre hash'i) OKUYAMAZ.
//    • Personel (@ogretmen.aat / admin): students + teachers dahil hepsini okur.
//    • Ortak koleksiyonlar (program, duyuru, anket, mesaj, yoklama, QR…):
//      giriş yapmış herkese açık (öğrenci paneli bunları kullanır).
//    • Site (girişsiz): yalnızca news, config/applications, applicationTemplates.
//
//  v4 — KİMLİK: e-posta uzantısı TEK BAŞINA yetki vermez.
//    Firebase Auth'ta herkes istemci API'siyle "x@ogretmen.aat" hesabı açabilir;
//    bu yüzden personel/öğrenci ayrıca personelin yazdığı DİZİNDE olmalıdır:
//    • Öğrenci   : <no>@ogrenci.aat   VE  idx_students/<no> mevcut
//    • Personel  : <no>@ogretmen.aat  VE  idx_staff/<no> mevcut
//                  (öğretmen / yönetici / basın / öğrenci işleri)
//    • Yönetici  : admin@aramtigran.edu (yedek, dizinden bağımsız)
//    Dizin, yönetici girişinde uygulama tarafından otomatik eşitlenir.
//
//  v5 — ROL AYRIMI (en az yetki):
//    • Yönetici (admin)          : her şey; personel dizini ve özel kartlar (basın / öğrenci işleri)
//    • Öğrenci İşleri (registrar): öğrenci + öğretmen kayıtları (yalnızca "teacher" seviyesi),
//                                  başvurular, Akademiya Zarokan yönetimi (çocuk/veli/öğretmen)
//    • Basın (press)             : yalnızca site haberleri + arşiv (ana site ve çocuk sitesi)
//    • Öğretmen (teacher)        : ders, yoklama, duyuru, anket; öğrenci ekleyebilir
//    • Bölüm sorumlusu (head)    : bölümünün raporlarını okur; yalnızca kendi bölümüne duyuru,
//                                  personele mesaj; öğrenciden mesaj alır (öğrenciye mesaj YAZAMAZ)
//    Hiçbir rol kendi seviyesini yükseltemez; basın/öğrenci işleri dizine "admin" yazamaz.
//    YAYIN SIRASI: önce yeni uygulama sürümü → yönetici bir kez giriş yapar →
//    Console'da idx_staff/idx_students dolu mu kontrol et → SONRA bu kuralları yayınla.
// ════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Yardımcılar ─────────────────────────────────────────────────────
    function authed()  { return request.auth != null && request.auth.token.email != null; }
    function mail()    { return request.auth.token.email; }
    function prefix()  { return mail().split('@')[0]; }
    function dbPath(c) { return /databases/$(database)/documents/$(c)/$(prefix()); }

    // Personel: dizinde kayıtlı öğretmen/yönetici (veya yedek admin hesabı)
    // (Kapı güvenlik görevlisi — lvl "gate" — personel SAYILMAZ: yalnızca kart doğrular)
    function isStaff() {
      return authed() && (
        mail() == 'admin@aramtigran.edu' ||
        (mail().matches('.*@ogretmen[.]aat$') && exists(dbPath('idx_staff'))
          && get(dbPath('idx_staff')).data.get('lvl', 'teacher') != 'gate')
      );
    }
    // Kapı güvenliği: yalnızca kart okutur (cards/{token} get) ve giriş kaydı yazar
    function isGate() {
      return authed() && mail().matches('.*@ogretmen[.]aat$') && exists(dbPath('idx_staff'))
        && get(dbPath('idx_staff')).data.get('lvl', 'teacher') == 'gate';
    }
    // Öğrenci: dizinde kayıtlı
    function isStudent() {
      return authed() && mail().matches('.*@ogrenci[.]aat$') && exists(dbPath('idx_students'));
    }
    // Personel seviyesi (idx_staff.lvl): admin · registrar · press · teacher
    function lvlIn(ls) {
      return mail() == 'admin@aramtigran.edu' ||
        (isStaff() && get(dbPath('idx_staff')).data.get('lvl', 'teacher') in ls);
    }
    function isAdmin()     { return authed() && lvlIn(['admin']); }
    function isRegistrar() { return authed() && lvlIn(['admin', 'registrar']); }   // hesap/başvuru yönetimi
    function isPress()     { return authed() && lvlIn(['admin', 'press']); }       // site haberleri + arşiv
    function isTeacherLvl(){ return authed() && mail() != 'admin@aramtigran.edu' && isStaff()
                                  && get(dbPath('idx_staff')).data.get('lvl', 'teacher') == 'teacher'; }
    // Bölüm sorumlusu (lvl "head"): kendi bölümünün raporlarını okur; yazabildiği tek şeyler
    // kendi bölümüne duyuru, öğrenci OLMAYAN personele mesaj ve gelen mesajın okundu işareti.
    function headLvl() {
      return authed() && mail().matches('.*@ogretmen[.]aat$') && exists(dbPath('idx_staff'))
        && get(dbPath('idx_staff')).data.get('lvl', 'teacher') == 'head';
    }
    function headArea() { return get(dbPath('idx_staff')).data.get('area', ''); }
    // Genel sorumlu (bölüm = "genel"): ana akademinin TÜM bölümleri
    function headGeneral() { return headLvl() && headArea() == 'genel'; }
    // Çocuk akademisi bölüm sorumlusu (bölüm = çocuk akademisi dersi)
    function kidHeadLvl() { return headLvl() && headArea() in ['solfej', 'ziman', 'teori', 'dalcroze', 'drama', 'enstruman']; }
    // Bir hedef listesi sorumlunun yetki alanında mı? (genel sorumlu: her bölüm)
    function headTargetsOk(ts) { return ts is list && ts.size() >= 1 && (headArea() == 'genel' || (ts.size() == 1 && ts[0] == headArea())); }
    // Personel yazması (bölüm sorumlusu HARİÇ)
    function staffW() { return isStaff() && !headLvl(); }
    // Geriye dönük ad: hesap yönetimi = admin + öğrenci işleri (basın DEĞİL)
    function isManager()   { return isRegistrar(); }
    // Özel yetki bayrağı taşımayan sıradan öğretmen kaydı
    function plainTeacher(d) {
      return d.get('isAdmin', false) != true && d.get('isPress', false) != true && d.get('isRegistrar', false) != true
        && d.get('isGate', false) != true && d.get('isHead', false) != true;
    }
    // Akademi üyesi (giriş yapmış + dizinde kayıtlı)
    function member() { return isStaff() || isStudent(); }

    // Kendi kaydında değiştirilemeyecek alanlar (alan, sınıf, burs, yetki bayrakları…)
    function selfEditOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['no','name','isAdmin','isPress','isRegistrar','isGate','isHead','area','classLevel','burs','scholarship','grade','regYear','status','role','cardToken']);
    }

    // Bir öğrenci/öğretmen dokümanı bu kullanıcıya mı ait? ("no" alanı = e-posta öneki)
    function ownsStudentDoc(d) { return isStudent() && mail() == d.no + '@ogrenci.aat'; }
    // Kendi personel kaydı (güvenlik görevlisi dahil) — e-posta Auth ile kanıtlı olduğundan güvenli
    function ownsTeacherDoc(d) { return authed() && mail() == d.no + '@ogretmen.aat'; }

    // Kendi kendine "admin" olmayı engelle (isAdmin alanı true yapılamaz)
    function notGrantingAdmin() {
      return !('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false;
    }
    // "no" alanı değiştirilemesin (kimliğini başkasınınkiyle değiştiremez)
    function noUnchanged() { return request.resource.data.no == resource.data.no; }

    // Başvuru dönemi açık mı? (public create yalnızca dönem açıkken)
    function applicationsOpen() {
      return exists(/databases/$(database)/documents/config/applications)
        && get(/databases/$(database)/documents/config/applications).data.open == true;
    }

    // ── Varsayılan: HER ŞEY KAPALI ──────────────────────────────────────
    // (Aşağıdaki kurallar okuma/yazmayı koleksiyon bazında açar.)
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Öğrenciler — okuma: personel VEYA kendi kaydı ──────────────────
    // (Öğrenci istemcisi yalnızca where("no","==",kendiNo) sorgusu yapar;
    //  bu sorgu kuralla kanıtlanabilir olduğundan çalışır.)
    match /students/{id} {
      allow read:   if isStaff() || ownsStudentDoc(resource.data);
      // Öğretmen yeni öğrenci ekleyebilir; düzenleme/silme öğrenci işleri + yönetici
      allow create: if isRegistrar() || isTeacherLvl();
      allow update: if isRegistrar()
                    || (ownsStudentDoc(resource.data) && noUnchanged() && notGrantingAdmin() && selfEditOk());
      allow delete: if isRegistrar() || ownsStudentDoc(resource.data);
    }

    // ── Üyelik dizini — yalnızca personel yazar; kişi kendi kaydını okuyabilir ──
    // Personel dizini: yönetici her seviyeyi yazar; öğrenci işleri yalnızca "teacher" seviyesini
    // (kendi kaydına ve yönetici/basın/öğrenci işleri kayıtlarına dokunamaz)
    match /idx_staff/{no} {
      allow read: if isStaff() || (authed() && prefix() == no);
      allow create, update: if isAdmin()
        || (isRegistrar() && no != prefix()
            && request.resource.data.get('lvl', '') == 'teacher'
            && (resource == null || resource.data.get('lvl', 'teacher') == 'teacher'));
      allow delete: if isAdmin() || (isRegistrar() && no != prefix() && resource.data.get('lvl', 'teacher') == 'teacher');
    }
    match /idx_students/{no} { allow read: if isStaff() || (authed() && prefix() == no); allow write: if isRegistrar(); }

    // ── Öğretmenler / Yönetici — okuma: yalnızca personel ──────────────
    match /teachers/{id} {
      allow read:   if isStaff() || ownsTeacherDoc(resource.data);
      // Öğretmen kaydı açma/silme/başkasını düzenleme: yalnızca yönetici seviyesi.
      // Öğretmen kendi profilini (foto, telefon, e-posta, adres, bio, şifre) düzenleyebilir.
      // Özel kartlar (isAdmin / isPress / isRegistrar) yalnızca yöneticiden
      allow create: if isAdmin() || (isRegistrar() && plainTeacher(request.resource.data));
      allow update: if isAdmin()
                    || (isRegistrar() && plainTeacher(resource.data) && plainTeacher(request.resource.data))
                    || (ownsTeacherDoc(resource.data) && noUnchanged() && notGrantingAdmin() && selfEditOk());
      allow delete: if isAdmin() || (isRegistrar() && plainTeacher(resource.data));
    }

    // ── Malper nûçe (ana sayfa haberleri) — HERKESE açık okuma ─────────
    match /news/{id} {
      allow read:  if true;
      allow write: if isPress();
    }

    // ── Arşîv (ana sayfa "Dîroka Akademiyê" zaman çizgisi) — açık okuma ─
    // Yönetici/basın panelinden girilen yıl bazlı kayıtlar; site girişsiz okur.
    match /archive/{id} {
      allow read:  if true;
      allow write: if isPress();
    }

    // ── Serlêdan (kayıt başvuruları) — public create, sıkı sınırlı ─────
    match /applications/{id} {
      allow create: if applicationsOpen()
                    && request.resource.data.keys().hasOnly(
                      ['name','phone','dob','area','note','docs','status','dateStr','createdAt','email','kvkk'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 30
                    && (!('dob'  in request.resource.data) || request.resource.data.dob.size()  <= 20)
                    && (!('area' in request.resource.data) || request.resource.data.area.size() <= 20)
                    && (!('note' in request.resource.data) || request.resource.data.note.size() <= 500)
                    && (!('email' in request.resource.data) || request.resource.data.email.size() <= 80)
                    && (!('dateStr' in request.resource.data) || request.resource.data.dateStr.size() <= 20)
                    && request.resource.data.status == 'new'
                    && request.resource.data.docs is list
                    && request.resource.data.docs.size() <= 8;
      allow read, update, delete: if isRegistrar();
    }
    // Başvuru dönemi ayarı — site (girişsiz) okuyabilsin, yazma öğrenci işleri
    match /config/applications {
      allow read:  if true;
      allow write: if isRegistrar();
    }
    // İstenen belgeler (şablonlar) — herkes görebilsin (indirir), yazma öğrenci işleri
    match /applicationTemplates/{id} {
      allow read:  if true;
      allow write: if isRegistrar();
    }

    // ── Ortak koleksiyonlar — okuma: giriş yapmış herkes ───────────────
    // (öğrenci paneli program/duyuru/anket/QR okur; yazma personel)
    // Ders programı: yönetici her dersi; bölüm sorumlusu yalnız KENDİ bölümünün derslerini ekler/düzenler/siler
    // (genel sorumlu: ana akademinin bütün dersleri). Öğrenci İşleri yalnız atölye dersini (ws_<sınıf>) yazar.
    // Öğretmen programı DEĞİŞTİREMEZ (yalnız okur, yoklama alır).
    function aatHead() { return headLvl() && !kidHeadLvl(); }
    function headSchedWrite() {
      return aatHead() && (headGeneral() || (request.resource.data.get('area', '') == headArea()
        && (resource == null || resource.data.get('area', '') == headArea())));
    }
    match /schedule/{id} {
      allow read: if member();
      allow create, update: if isAdmin() || (isRegistrar() && id.matches('ws_.*')) || headSchedWrite();
      allow delete: if isAdmin() || (isRegistrar() && id.matches('ws_.*'))
        || (aatHead() && (headGeneral() || resource.data.get('area', '') == headArea()));
    }
    // Sınıflar: öğrencinin sınıfı students.classLevel; sınıf öğretmeni burada (doc id = <alan>_<seviye>)
    match /classes/{id}           { allow read: if member(); allow write: if isRegistrar(); }
    // Sınıf paylaşımları (duyuru/ödev/belge): öğretmen YALNIZCA sınıf öğretmeni olduğu sınıfa, kendi adıyla yazar
    function clsDoc(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    // Sınıfa paylaşım: sınıf öğretmeni YA DA o sınıfa bağlı dersi veren öğretmen (lessonId ile kanıtlar)
    function teachesClassLesson(sc) {
      return request.resource.data.get('lessonId', '') is string && request.resource.data.get('lessonId', '') != ''
        && exists(clsDoc(sc, request.resource.data.lessonId))
        && get(clsDoc(sc, request.resource.data.lessonId)).data.get('classId', '') == request.resource.data.classId
        && string(get(clsDoc(sc, request.resource.data.lessonId)).data.get('teacherNo', '')) == prefix();
    }
    function classPostOk(c, sc) {
      return request.resource.data.teacherNo == prefix()
        && request.resource.data.classId is string
        && exists(clsDoc(c, request.resource.data.classId))
        && (prefix() in get(clsDoc(c, request.resource.data.classId)).data.get('teacherNos', []) || teachesClassLesson(sc))
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 140
        && request.resource.data.type in ['duyuru', 'odev', 'belge'];
    }
    match /classPosts/{id} {
      allow read: if member();
      allow create: if isRegistrar() || (staffW() && classPostOk('classes', 'schedule'));
      allow update: if isRegistrar();
      allow delete: if isRegistrar() || (isStaff() && resource.data.teacherNo == prefix());
    }
    // Duyuru: bölüm sorumlusu yalnızca KENDİ adıyla ve YALNIZCA kendi bölümüne
    function headAnnOk(d) {
      return d.get('senderRole', '') == 'head' && d.get('senderNo', '') == prefix() && !kidHeadLvl()
        && headTargetsOk(d.get('targets', [])) && d.get('senderArea', '') == headArea();
    }
    // Sıradan öğretmen alan geneline duyuru YAZAMAZ: yalnızca kendi sınıflarına (classPosts type "duyuru")
    match /announcements/{id} {
      allow read: if member();
      allow create: if (staffW() && !isTeacherLvl()) || (headLvl() && headAnnOk(request.resource.data));
      allow update: if (staffW() && !isTeacherLvl()) || (headLvl() && headAnnOk(resource.data) && headAnnOk(request.resource.data));
      allow delete: if (staffW() && !isTeacherLvl()) || (headLvl() && headAnnOk(resource.data));
    }
    // Anket: bölüm sorumlusu KENDİ anketini, KENDİ bölümüne (genel sorumlu: her bölüme) açar
    function headSurveyOk(d) {
      return d.get('ownerNo', '') == prefix() && !kidHeadLvl()
        && (headArea() == 'genel' || (d.get('targetType', '') in ['area', 'teachers_area'] && headTargetsOk(d.get('targetAreas', []))));
    }
    match /studentSurveys/{id} {
      allow read: if member();
      allow create: if staffW() || (headLvl() && headSurveyOk(request.resource.data));
      allow update: if staffW() || (headLvl() && headSurveyOk(resource.data) && headSurveyOk(request.resource.data));
      allow delete: if staffW() || (headLvl() && headSurveyOk(resource.data));
    }
    match /studentStats/{id}      { allow read: if isStaff(); allow write: if staffW(); }
    match /teacherLessonLogs/{id} { allow read: if isStaff(); allow write: if staffW(); }
    match /qrSessions/{id}        { allow read: if member(); allow write: if staffW(); }
    match /config/{id}            { allow read: if member(); allow write: if isRegistrar(); }
    match /admins/{id}            { allow read: if isStaff(); allow write: if isAdmin(); }

    // ── Roller — personel her rolü yazabilir (kullanıcı oluşturma için);
    //    normal kullanıcı yalnızca KENDİ uid'ini yazar ve admin olamaz ──
    match /roles/{uid} {
      allow read:  if isStaff() || (authed() && request.auth.uid == uid);
      allow write: if isRegistrar();
    }

    // ── Hem öğrenci hem personel okur/yazar ────────────────────────────
    //   attendance: öğrenci QR check-in + öğretmen yoklama kaydı
    //   messages / survey responses: öğrenci gönderir (istemci filtreli sorgular)
    //   devices: kullanıcı kendi cihaz kaydını yazar
    // Yoklama: personel her kaydı yazar; öğrenci yalnızca KENDİ adına QR girişi yazar (silemez)
    // Bölüm sorumlusu: kendi bölümünün dersine "ders yapılmadı" işareti (neden + açıklama). Yoklama
    // kayıtlarına (records) dokunamaz; yeni belgede records boş olmalı.
    // Misafir öğretmenli ders (programda guestTeacher dolu, teacherNo boş): yoklamayı bölüm sorumlusu yazar
    function headGuestAttOk(aid) {
      let d = request.resource.data;
      let sp = /databases/$(database)/documents/schedule/$(d.get('lessonFire', '-'));
      return aatHead() && exists(sp)
        && get(sp).data.get('guestTeacher', '') is string && get(sp).data.get('guestTeacher', '') != ''
        && get(sp).data.get('teacherNo', null) == null
        && string(get(sp).data.get('id', '')) == d.get('lessonId', '')
        && (headGeneral() || get(sp).data.get('area', '') == headArea())
        && aid == d.get('lessonId', '') + '-' + d.get('date', '')
        && d.records is map && d.get('takenByNo', '') == prefix();
    }
    function headAbsenceOk() {
      let d = request.resource.data;
      let absKeys = ['teacherAbsent', 'absenceKind', 'absenceNote', 'absenceBy', 'updatedAt'];
      let meta = ['lessonId', 'lessonName', 'classId', 'teacherName', 'date'];
      return aatHead() && (headGeneral() || d.get('area', '') == headArea())
        && (resource == null
              ? (d.keys().hasOnly(absKeys.concat(meta).concat(['area', 'records'])) && d.get('records', {}).size() == 0)
              : ((headGeneral() || resource.data.get('area', '') == headArea())
                 && d.diff(resource.data).affectedKeys().hasOnly(absKeys.concat(meta))));
    }
    // Öğrenci izni: bölüm sorumlusu kendi bölümünün öğrencisine (çocuk akademisi sorumlusu kendi dersinin
    // çocuğuna) izin işler; izinli öğrenci yoklama listesinde görünmez. Yönetici her izni işler/siler.
    function leaveOk(d) {
      return d.keys().hasOnly(['studentNo', 'studentId', 'studentName', 'area', 'from', 'to', 'reason', 'by', 'byNo', 'kid', 'createdAt', 'lessonIds', 'lessonNames'])
        && d.studentNo is string && d.from is string && d.to is string && d.from <= d.to
        && (!('lessonIds' in d) || (d.lessonIds is list && d.lessonIds.size() <= 20))
        && (!('lessonNames' in d) || (d.lessonNames is list && d.lessonNames.size() <= 20))
        && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 300
        && d.kid is bool && d.byNo == prefix();
    }
    match /studentLeaves/{id} {
      allow read: if isStaff() || kidRead();
      allow create: if leaveOk(request.resource.data) && (isAdmin()
        || (request.resource.data.kid == true && kidHeadLvl() && request.resource.data.area == headArea())
        || (request.resource.data.kid == false && aatHead() && (headGeneral() || request.resource.data.area == headArea())));
      allow delete: if isAdmin() || (headLvl() && resource.data.byNo == prefix());
    }
    match /attendance/{id} {
      allow read: if member();
      allow create, update: if staffW() || headAbsenceOk() || headGuestAttOk(id)
        || (isStudent()
            && string(request.resource.data.get('studentNo', '')) == prefix()
            && (resource == null || string(resource.data.get('studentNo', '')) == prefix()));
      allow delete: if staffW();
    }
    // Mesajlar: personel hepsini okur/yazar. Öğrenci yalnızca KENDİNE gelen özel mesajı
    // (recipientNo == kendi no) ve öğrencilere yönelik toplu mesajları okur; yalnızca
    // yönetime/öğretmene "öğrenci" olarak yazabilir (yönetici adına veya toplu mesaj atamaz).
    function studentGroup(d) {
      return d.get('recipientGroup', '') in ['allStudents', 'all'] || string(d.get('recipientGroup', '')).matches('area_[a-z]+');
    }
    // Bölüm sorumlusunun mesajı: kendi adıyla, tek alıcıya; alıcı yönetici ya da ÖĞRENCİ OLMAYAN personel
    // (öğrencilere yalnızca duyuru gönderir)
    function headMsgOk(d) {
      return d.get('fromType', '') == 'head' && d.get('senderNo', '') == prefix()
        && d.get('recipientGroup', null) == null
        && ((d.get('recipientId', '') == 'admin' && d.get('recipientNo', null) == null)
            || (d.get('recipientNo', null) is string && d.get('recipientNo', '') != ''
                && exists(/databases/$(database)/documents/idx_staff/$(d.get('recipientNo', ''))))
            || headReplyOk(d))
        && string(d.get('body', '')).size() <= 5000 && string(d.get('subject', '')).size() <= 300;
    }
    // Sorumlunun öğrenciye CEVABI: yalnızca o öğrencinin sorumluya (bu bölüme) yazdığı mesaja
    function origMsg(d) { return get(/databases/$(database)/documents/messages/$(d.replyTo)).data; }
    function headReplyOk(d) {
      return d.get('replyTo', '') is string && d.get('replyTo', '') != ''
        && exists(/databases/$(database)/documents/messages/$(d.get('replyTo', '')))
        && origMsg(d).get('toRole', '') == 'head'
        && (origMsg(d).get('toArea', '') == headArea())
        && origMsg(d).get('fromNo', '') != '' && origMsg(d).get('fromNo', '') == d.get('recipientNo', '');
    }
    match /messages/{id} {
      allow read: if isStaff()
        || (isStudent() && (resource.data.get('recipientNo', '') == prefix() || studentGroup(resource.data)
            || resource.data.get('fromNo', '') == prefix()));
      allow create: if staffW()
        || (headLvl() && headMsgOk(request.resource.data))
        || (isStudent()
            && request.resource.data.get('fromType', '') == 'student'
            && request.resource.data.get('senderId', '') != 'admin'
            && request.resource.data.get('recipientGroup', null) == null
            && request.resource.data.get('recipientNo', null) == null
            && request.resource.data.get('toRole', '') in ['admin', 'teacher', 'head']
            && request.resource.data.get('fromNo', prefix()) == prefix()
            && string(request.resource.data.get('body', '')).size() <= 5000
            && string(request.resource.data.get('subject', '')).size() <= 300);
      allow update: if staffW()
        || ((headLvl() || (isStudent() && resource.data.get('recipientNo', '') == prefix()))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']));
      allow delete: if staffW();
    }
    // ── Haftalık değerlendirmeler ──
    //  Puanlar 1–5 (4 ölçüt), not ≤ 1000. Sonuçları yalnızca yönetici ve bölüm sorumluları okur.
    //  studentEvals: öğretmen → öğrenci. Öğretmen yalnızca KENDİ yazdığını okur/düzeltir; öğrenci hiç okuyamaz.
    //  teacherEvals: öğrenci → öğretmen (isimsiz raporlanır). Öğrenci yalnızca kendi gönderdiğini okur; öğretmen hiç okuyamaz.
    function sc5(v) { return v is int && v >= 1 && v <= 5; }
    function evalOk(d, keys) {
      return d.c is map && d.c.keys().hasOnly(keys) && d.c.keys().hasAll(keys)
        && sc5(d.c[keys[0]]) && sc5(d.c[keys[1]]) && sc5(d.c[keys[2]]) && sc5(d.c[keys[3]])
        && d.wk is string && d.wk.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.get('note', '') is string && d.get('note', '').size() <= 1000;
    }
    match /studentEvals/{id} {
      allow read: if isAdmin() || headLvl() || (staffW() && resource.data.teacherNo == prefix());
      allow create, update: if staffW() && !isRegistrar()
        && request.resource.data.teacherNo == prefix()
        && id == request.resource.data.wk + '_' + prefix() + '_' + request.resource.data.studentNo
        && evalOk(request.resource.data, ['p', 'g', 'h', 'b'])
        && (resource == null || resource.data.teacherNo == prefix());
      allow delete: if isAdmin();
    }
    match /teacherEvals/{id} {
      allow read: if isAdmin() || headLvl() || (isStudent() && resource.data.studentNo == prefix());
      allow create, update: if isStudent()
        && request.resource.data.studentNo == prefix()
        && id == request.resource.data.wk + '_' + prefix() + '_' + request.resource.data.teacherNo
        && evalOk(request.resource.data, ['e', 'h', 'r', 'f'])
        && !('studentName' in request.resource.data)
        && (resource == null || resource.data.studentNo == prefix());
      allow delete: if isAdmin();
    }
    // Öğretmen haftalık anketleri: yalnızca personel
    match /surveyResponses/{id} { allow read: if isStaff(); allow write: if staffW(); }
    // Öğrenci anket yanıtları: öğrenci yalnızca KENDİ yanıtını (studentNo == kendi no) okur/yazar
    match /studentSurveyResponses/{id} {
      allow read: if isStaff() || (isStudent() && resource.data.get('studentNo', '') == prefix());
      allow create, update: if staffW()
        || (isStudent() && request.resource.data.get('studentNo', '') == prefix()
            && (resource == null || resource.data.get('studentNo', '') == prefix()));
      allow delete: if staffW();
    }
    // Cihaz kaydı: doküman kimliği = kullanıcı no; herkes yalnızca kendi cihazını
    match /devices/{no} {
      allow read: if isStaff() || (member() && prefix() == no);
      allow write: if staffW() || (member() && prefix() == no);
    }

    // ════════════════════════════════════════════════════════════════════
    //  AKADEMIYA ZAROKAN (Çocuk Akademisi) — yalnızca VELİ girişi
    //    Veli : <no>@veli.aat  VE  idx_guardians/<no> mevcut
    //    Çocuğun kendi hesabı YOKTUR. Veli yalnızca guardianNos listesinde
    //    olduğu çocukları, onların yoklamasını ve kendi mesajlarını görür.
    //    Yetişkin öğrenci verisine (students, messages…) hiçbir erişimi yoktur.
    // ════════════════════════════════════════════════════════════════════
    function isGuardian() {
      return authed() && mail().matches('.*@veli[.]aat$') && exists(dbPath('idx_guardians'));
    }
    function myKid(d) { return isGuardian() && prefix() in d.guardianNos; }
    // Çocuk akademisi öğretmeni: <no>@zmamoste.aat VE idx_kidstaff/<no>
    // (yetişkin akademinin öğrenci/öğretmen verisine ERİŞEMEZ)
    function isKidTeacher() {
      return authed() && mail().matches('.*@zmamoste[.]aat$') && exists(dbPath('idx_kidstaff'));
    }
    // Çocuk tarafında personel: yönetici / öğrenci işleri, çocuk öğretmeni VEYA
    // Öğrenci İşleri'nin çocuk akademisine bağladığı akademi öğretmeni (idx_kidstaff/<no>)
    function kidStaff() {
      return isRegistrar() || isKidTeacher()
        || (isStaff() && exists(dbPath('idx_kidstaff')));
    }
    // Çocuk tarafını OKUYABİLEN: personel + çocuk akademisi bölüm sorumlusu (yazma ayrı kurallarla)
    function kidRead() { return kidStaff() || kidHeadLvl(); }

    match /idx_guardians/{no} { allow read: if isStaff() || (authed() && prefix() == no); allow write: if isRegistrar(); }
    match /idx_kidstaff/{no}  { allow read: if isStaff() || (authed() && prefix() == no); allow write: if isRegistrar(); }

    // Çocuk akademisi öğretmen kayıtları (doc id = öğretmen no)
    match /kidTeachers/{no} {
      allow read:  if kidRead();
      allow write: if isRegistrar();
    }
    // Çocuk akademisi sitesi: haberler ve arşiv (tarih) — herkese açık okuma, yazma BASIN
    match /kidNews/{id}    { allow read: if true; allow write: if isPress(); }
    match /kidArchive/{id} { allow read: if true; allow write: if isPress(); }

    // Başvuru dönemi (site girişsiz okur)
    match /config/zarok { allow read: if true; allow write: if isRegistrar(); }
    // İstenen belgeler (şablonlar) — site girişsiz görür/indirir, yazma öğrenci işleri
    match /kidApplicationTemplates/{id} { allow read: if true; allow write: if isRegistrar(); }
    function zarokOpen() {
      return exists(/databases/$(database)/documents/config/zarok)
        && get(/databases/$(database)/documents/config/zarok).data.open == true;
    }
    function optStr(k, n) { return !(k in request.resource.data) || (request.resource.data[k] is string && request.resource.data[k].size() <= n); }

    // Veli başvurusu — girişsiz oluşturma, sıkı doğrulama
    match /kidApplications/{id} {
      allow create: if zarokOpen()
        && request.resource.data.keys().hasOnly(['kidName','kidDob','area','school','guardianName','relation',
             'phone','phone2','email','health','consentKvkk','consentPhoto','consentShare','docs','status','dateStr','createdAt','note'])
        && request.resource.data.kidName is string && request.resource.data.kidName.size() > 0 && request.resource.data.kidName.size() <= 80
        && request.resource.data.guardianName is string && request.resource.data.guardianName.size() > 0 && request.resource.data.guardianName.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 30
        && request.resource.data.consentKvkk == true
        && request.resource.data.status == 'new'
        && optStr('kidDob', 20) && optStr('area', 20) && optStr('school', 80) && optStr('relation', 30)
        && optStr('phone2', 30) && optStr('email', 80) && optStr('health', 500) && optStr('note', 500) && optStr('dateStr', 20)
        && (!('docs' in request.resource.data) || (request.resource.data.docs is list && request.resource.data.docs.size() <= 12));
      allow read, update, delete: if isRegistrar();
    }

    // Veli kaydı (doc id = veli no)
    match /guardians/{no} {
      allow read:  if kidRead() || (isGuardian() && prefix() == no);
      allow write: if isRegistrar();
    }

    // Çocuk kaydı — veli yalnızca izin/teslim/sağlık alanlarını güncelleyebilir
    match /kids/{id} {
      allow read:   if kidRead() || myKid(resource.data);
      allow create, delete: if isRegistrar();
      allow update: if isRegistrar()
        || (myKid(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pickups','consentPhoto','consentShare','health','updatedAt']));
    }

    // Giriş/çıkış yoklaması (öğretmen/öğrenci işleri yazar, veli okur)
    match /kidAttendance/{id} {
      allow read:  if kidRead() || myKid(resource.data);
      allow write: if kidStaff();
    }

    // Çocuk akademisi programı: yönetici her dersi; çocuk akademisi bölüm sorumlusu yalnız KENDİ dersinin (alan)
    // haftalık derslerini; Öğrenci İşleri yalnız atölye dersini (ws_<sınıf>).
    function kidHeadSchedWrite() {
      return kidHeadLvl() && request.resource.data.get('area', '') == headArea()
        && (resource == null || resource.data.get('area', '') == headArea());
    }
    match /kidSchedule/{id} {
      allow read: if kidRead() || isGuardian();
      allow create, update: if isAdmin() || (isRegistrar() && id.matches('ws_.*')) || kidHeadSchedWrite();
      allow delete: if isAdmin() || (isRegistrar() && id.matches('ws_.*'))
        || (kidHeadLvl() && resource.data.get('area', '') == headArea());
    }
    // Sınıflar (1., 2., …): çocuğun sınıfı kids.classLevel; sınıf öğretmeni burada (doc id = L<seviye>)
    match /kidClasses/{id}       { allow read: if kidRead() || isGuardian(); allow write: if isRegistrar(); }
    // Çocuk Akademisi anketleri: öğrenci işleri/yönetici oluşturur (hedef: "guardians" veliler | "kidteachers" öğretmenler).
    // Veli / çocuk öğretmeni yalnızca KENDİ adına ve kendisine yönelik aktif ankete BİR kez (güncelleyerek) yanıt verir.
    function kidHeadSurveyOk(d) {
      return kidHeadLvl() && d.get('ownerNo', '') == prefix() && headTargetsOk(d.get('targetAreas', []));
    }
    match /kidSurveys/{id} {
      allow read: if kidRead() || isGuardian();
      allow create: if isRegistrar() || kidHeadSurveyOk(request.resource.data);
      allow update: if isRegistrar() || (kidHeadSurveyOk(resource.data) && kidHeadSurveyOk(request.resource.data));
      allow delete: if isRegistrar() || kidHeadSurveyOk(resource.data);
    }
    function kidSurveyTarget(sid) { return get(/databases/$(database)/documents/kidSurveys/$(sid)).data; }
    match /kidSurveyResponses/{id} {
      allow read: if isRegistrar() || kidHeadLvl() || (authed() && resource.data.no == prefix());
      allow create, update: if authed()
        && id == request.resource.data.surveyId + '_' + prefix()
        && request.resource.data.no == prefix()
        && request.resource.data.keys().hasOnly(['surveyId','role','no','name','areas','answers','submittedAt'])
        && request.resource.data.answers is map && request.resource.data.answers.size() <= 60
        && (!('areas' in request.resource.data) || (request.resource.data.areas is list && request.resource.data.areas.size() <= 10))
        && exists(/databases/$(database)/documents/kidSurveys/$(request.resource.data.surveyId))
        && kidSurveyTarget(request.resource.data.surveyId).active == true
        && ((request.resource.data.role == 'guardian' && isGuardian()
              && kidSurveyTarget(request.resource.data.surveyId).targetType == 'guardians')
            || (request.resource.data.role == 'teacher' && (isKidTeacher() || (isStaff() && exists(dbPath('idx_kidstaff'))))
              && kidSurveyTarget(request.resource.data.surveyId).targetType == 'kidteachers'));
      allow delete: if isRegistrar();
    }
    match /kidClassPosts/{id} {
      allow read: if kidRead() || isGuardian();
      allow create: if isRegistrar() || (kidStaff() && classPostOk('kidClasses', 'kidSchedule'));
      allow update: if isRegistrar();
      allow delete: if isRegistrar() || (kidStaff() && resource.data.teacherNo == prefix());
    }
    // Duyuru: çocuk akademisi bölüm sorumlusu YALNIZCA kendi bölümüne, kendi adıyla
    function kidHeadAnnOk(d) { return kidHeadLvl() && d.get('byNo', '') == prefix() && d.get('area', '') == headArea(); }
    // Çocuk öğretmeni genel duyuru YAZAMAZ: yalnızca kendi sınıflarına (kidClassPosts type "duyuru")
    match /kidAnnouncements/{id} {
      allow read: if kidRead() || isGuardian();
      allow create: if isRegistrar() || kidHeadAnnOk(request.resource.data);
      allow update: if isRegistrar() || (kidHeadAnnOk(resource.data) && kidHeadAnnOk(request.resource.data));
      allow delete: if isRegistrar() || kidHeadAnnOk(resource.data);
    }
    // ── Çocuk akademisi haftalık değerlendirmeleri (sonuçları yalnız yönetici + çocuk akademisi sorumlusu okur) ──
    //  kidEvals: öğretmen → çocuk. Öğretmen yalnız kendi yazdığını okur/düzeltir; veli okuyamaz.
    //  kidTeacherEvals: veli → öğretmen (isimsiz raporlanır). Veli yalnız kendi gönderdiğini okur; öğretmen okuyamaz.
    function kidTeach() { return isKidTeacher() || (isStaff() && !headLvl() && exists(dbPath('idx_kidstaff'))); }
    match /kidEvals/{id} {
      allow read: if isAdmin() || kidHeadLvl() || headGeneral() || (kidTeach() && resource.data.teacherNo == prefix());
      allow create, update: if kidTeach()
        && request.resource.data.teacherNo == prefix()
        && id == request.resource.data.wk + '_' + prefix() + '_' + request.resource.data.kidNo
        && evalOk(request.resource.data, ['p', 'g', 'h', 'b'])
        && (resource == null || resource.data.teacherNo == prefix());
      allow delete: if isAdmin();
    }
    match /kidTeacherEvals/{id} {
      allow read: if isAdmin() || kidHeadLvl() || headGeneral() || (isGuardian() && resource.data.guardianNo == prefix());
      allow create, update: if isGuardian()
        && request.resource.data.guardianNo == prefix()
        && id == request.resource.data.wk + '_' + prefix() + '_' + request.resource.data.teacherNo
        && evalOk(request.resource.data, ['e', 'h', 'r', 'f'])
        && (resource == null || resource.data.guardianNo == prefix());
      allow delete: if isAdmin();
    }

    // Anlık bildirim cihaz kayıtları: herkes yalnızca KENDİ cihazını, KENDİ numarası ve rolüyle kaydeder.
    // Okuma/silme yalnızca sahibi; gönderimi sunucu (Cloud Functions) yapar.
    function pushRoleOk(r) {
      return (isStudent() && r == 'student')
        || (isStaff() && r in ['teacher', 'registrar', 'press', 'admin', 'gate', 'head'])
        || (isGuardian() && r == 'guardian')
        || (kidStaff() && r == 'kidteacher');
    }
    match /pushTokens/{t} {
      allow read, delete: if authed() && resource.data.uid == request.auth.uid;
      allow create, update: if authed()
        && request.resource.data.keys().hasOnly(['uid', 'no', 'role', 'app', 'lang', 'area', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && string(request.resource.data.no) == prefix()
        && request.resource.data.app in ['aat', 'zarok']
        && pushRoleOk(request.resource.data.role)
        && (resource == null || resource.data.uid == request.auth.uid);
    }

    // Veli ↔ akademi mesajları
    match /kidMessages/{id} {
      allow read: if kidRead() || (isGuardian() && resource.data.guardianNo == prefix());
      allow create: if kidStaff()
        // Çocuk akademisi bölüm sorumlusu veliye cevap yazar (kendi adıyla, kayıtlı veliye)
        || (kidHeadLvl()
            && request.resource.data.keys().hasOnly(['guardianNo','guardianName','text','from','by','byNo','read','createdAt'])
            && request.resource.data.from == 'staff' && request.resource.data.byNo == prefix()
            && exists(/databases/$(database)/documents/guardians/$(request.resource.data.guardianNo))
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000)
        || (isGuardian()
            && request.resource.data.keys().hasOnly(['guardianNo','guardianName','kidId','kidName','text','from','read','createdAt','toTeacherNo','toName'])
            && request.resource.data.guardianNo == prefix()
            && request.resource.data.get('toTeacherNo', '') is string && request.resource.data.get('toName', '') is string
            && request.resource.data.from == 'guardian'
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000);
      allow update: if kidStaff()
        || (kidHeadLvl() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isRegistrar();
    }

    // ════════════════════════════════════════════════════════════════════
    //  ÖĞRENCİ KARTLARI (yetişkin + çocuk) — QR içinde tahmin edilemez anahtar (128 bit)
    //    cards/{token}: {kind:'student'|'kid', no, ref, name, area, photo, active}
    //    • Anahtarı bilen (kartı elinde tutan) yetkili okutur; LİSTELENEMEZ (tahmin/tarama yok)
    //    • Yalnızca öğrenci işleri + yönetici kart çıkarır / iptal eder
    // ════════════════════════════════════════════════════════════════════
    match /cards/{token} {
      allow get:  if staffW() || isGate() || (aatHead() && resource.data.kind == 'student') || (isKidTeacher() && resource.data.kind == 'kid');
      allow list: if isRegistrar();
      allow create, update, delete: if isRegistrar();
    }
    // Kapı / ders girişi kaydı — okutan kişi kendi numarasıyla yazar; değiştirilemez, silinemez
    match /gateLog/{id} {
      allow create: if (isGate() || staffW() || isKidTeacher())
        && request.resource.data.keys().hasOnly(['token','no','kind','name','ok','by','byName','at','date','place'])
        && request.resource.data.by == prefix()
        && request.resource.data.date is string && request.resource.data.date.size() <= 10
        && request.resource.data.get('place', 'gate') in ['gate', 'lesson'];
      allow read: if isRegistrar() || ((isGate() || isStaff() || isKidTeacher()) && resource.data.by == prefix());
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
