rules_version = '2';

// ════════════════════════════════════════════════════════════════════════
//  Akademîya Aram Tîgran — Firestore Security Rules  (v4: üyelik dizini)
//  ----------------------------------------------------------------------
//  YAZMA: rol bazlı kilitli (önceki sürümle aynı).
//  OKUMA: artık varsayılan KAPALI.
//    • Öğrenci: yalnızca KENDİ students dokümanını okur (no == e-posta öneki).
//      Diğer öğrencileri ve öğretmen listesini (PII + şifre hash'i) OKUYAMAZ.
//    • Personel (@ogretmen.aat / admin): students + teachers dahil hepsini okur.
//    • Ortak koleksiyonlar (program, duyuru, anket, mesaj, yoklama, QR…):
//      giriş yapmış herkese açık (öğrenci paneli bunları kullanır).
//    • Site (girişsiz): yalnızca news, config/applications, applicationTemplates.
//
//  v4 — KİMLİK: e-posta uzantısı TEK BAŞINA yetki vermez.
//    Firebase Auth'ta herkes istemci API'siyle "x@ogretmen.aat" hesabı açabilir;
//    bu yüzden personel/öğrenci ayrıca personelin yazdığı DİZİNDE olmalıdır:
//    • Öğrenci   : <no>@ogrenci.aat   VE  idx_students/<no> mevcut
//    • Personel  : <no>@ogretmen.aat  VE  idx_staff/<no> mevcut
//                  (öğretmen / yönetici / basın / öğrenci işleri)
//    • Yönetici  : admin@aramtigran.edu (yedek, dizinden bağımsız)
//    Dizin, yönetici girişinde uygulama tarafından otomatik eşitlenir.
//    YAYIN SIRASI: önce yeni uygulama sürümü → yönetici bir kez giriş yapar →
//    Console'da idx_staff/idx_students dolu mu kontrol et → SONRA bu kuralları yayınla.
// ════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Yardımcılar ─────────────────────────────────────────────────────
    function authed()  { return request.auth != null && request.auth.token.email != null; }
    function mail()    { return request.auth.token.email; }
    function prefix()  { return mail().split('@')[0]; }
    function dbPath(c) { return /databases/$(database)/documents/$(c)/$(prefix()); }

    // Personel: dizinde kayıtlı öğretmen/yönetici (veya yedek admin hesabı)
    function isStaff() {
      return authed() && (
        mail() == 'admin@aramtigran.edu' ||
        (mail().matches('.*@ogretmen[.]aat$') && exists(dbPath('idx_staff')))
      );
    }
    // Öğrenci: dizinde kayıtlı
    function isStudent() {
      return authed() && mail().matches('.*@ogrenci[.]aat$') && exists(dbPath('idx_students'));
    }
    // Yönetici seviyesi: admin / öğrenci işleri / basın (idx_staff.lvl)
    function isManager() {
      return authed() && (
        mail() == 'admin@aramtigran.edu' ||
        (isStaff() && get(dbPath('idx_staff')).data.get('lvl', 'teacher') in ['admin', 'registrar', 'press'])
      );
    }
    // Akademi üyesi (giriş yapmış + dizinde kayıtlı)
    function member() { return isStaff() || isStudent(); }

    // Kendi kaydında değiştirilemeyecek alanlar (alan, sınıf, burs, yetki bayrakları…)
    function selfEditOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['no','name','isAdmin','isPress','isRegistrar','area','classLevel','burs','scholarship','grade','regYear','status','role']);
    }

    // Bir öğrenci/öğretmen dokümanı bu kullanıcıya mı ait? ("no" alanı = e-posta öneki)
    function ownsStudentDoc(d) { return isStudent() && mail() == d.no + '@ogrenci.aat'; }
    function ownsTeacherDoc(d) { return isStaff()   && mail() == d.no + '@ogretmen.aat'; }

    // Kendi kendine "admin" olmayı engelle (isAdmin alanı true yapılamaz)
    function notGrantingAdmin() {
      return !('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false;
    }
    // "no" alanı değiştirilemesin (kimliğini başkasınınkiyle değiştiremez)
    function noUnchanged() { return request.resource.data.no == resource.data.no; }

    // Başvuru dönemi açık mı? (public create yalnızca dönem açıkken)
    function applicationsOpen() {
      return exists(/databases/$(database)/documents/config/applications)
        && get(/databases/$(database)/documents/config/applications).data.open == true;
    }

    // ── Varsayılan: HER ŞEY KAPALI ──────────────────────────────────────
    // (Aşağıdaki kurallar okuma/yazmayı koleksiyon bazında açar.)
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Öğrenciler — okuma: personel VEYA kendi kaydı ──────────────────
    // (Öğrenci istemcisi yalnızca where("no","==",kendiNo) sorgusu yapar;
    //  bu sorgu kuralla kanıtlanabilir olduğundan çalışır.)
    match /students/{id} {
      allow read:   if isStaff() || ownsStudentDoc(resource.data);
      allow create: if isStaff();
      allow update: if isStaff()
                    || (ownsStudentDoc(resource.data) && noUnchanged() && notGrantingAdmin() && selfEditOk());
      allow delete: if isStaff() || ownsStudentDoc(resource.data);
    }

    // ── Üyelik dizini — yalnızca personel yazar; kişi kendi kaydını okuyabilir ──
    match /idx_staff/{no}    { allow read: if isStaff() || (authed() && prefix() == no); allow write: if isManager(); }
    match /idx_students/{no} { allow read: if isStaff() || (authed() && prefix() == no); allow write: if isManager(); }

    // ── Öğretmenler / Yönetici — okuma: yalnızca personel ──────────────
    match /teachers/{id} {
      allow read:   if isStaff() || ownsTeacherDoc(resource.data);
      // Öğretmen kaydı açma/silme/başkasını düzenleme: yalnızca yönetici seviyesi.
      // Öğretmen kendi profilini (foto, telefon, e-posta, adres, bio, şifre) düzenleyebilir.
      allow create: if isManager();
      allow update: if isManager()
                    || (ownsTeacherDoc(resource.data) && noUnchanged() && notGrantingAdmin() && selfEditOk());
      allow delete: if isManager();
    }

    // ── Malper nûçe (ana sayfa haberleri) — HERKESE açık okuma ─────────
    match /news/{id} {
      allow read:  if true;
      allow write: if isStaff();
    }

    // ── Arşîv (ana sayfa "Dîroka Akademiyê" zaman çizgisi) — açık okuma ─
    // Yönetici/basın panelinden girilen yıl bazlı kayıtlar; site girişsiz okur.
    match /archive/{id} {
      allow read:  if true;
      allow write: if isStaff();
    }

    // ── Serlêdan (kayıt başvuruları) — public create, sıkı sınırlı ─────
    match /applications/{id} {
      allow create: if applicationsOpen()
                    && request.resource.data.keys().hasOnly(
                      ['name','phone','dob','area','note','docs','status','dateStr','createdAt','email','kvkk'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 30
                    && (!('dob'  in request.resource.data) || request.resource.data.dob.size()  <= 20)
                    && (!('area' in request.resource.data) || request.resource.data.area.size() <= 20)
                    && (!('note' in request.resource.data) || request.resource.data.note.size() <= 500)
                    && (!('email' in request.resource.data) || request.resource.data.email.size() <= 80)
                    && (!('dateStr' in request.resource.data) || request.resource.data.dateStr.size() <= 20)
                    && request.resource.data.status == 'new'
                    && request.resource.data.docs is list
                    && request.resource.data.docs.size() <= 8;
      allow read, update, delete: if isStaff();
    }
    // Başvuru dönemi ayarı — site (girişsiz) okuyabilsin, yazma personel
    match /config/applications {
      allow read:  if true;
      allow write: if isStaff();
    }
    // İstenen belgeler (şablonlar) — herkes görebilsin (indirir), yazma personel
    match /applicationTemplates/{id} {
      allow read:  if true;
      allow write: if isStaff();
    }

    // ── Ortak koleksiyonlar — okuma: giriş yapmış herkes ───────────────
    // (öğrenci paneli program/duyuru/anket/QR okur; yazma personel)
    match /schedule/{id}          { allow read: if member(); allow write: if isStaff(); }
    match /announcements/{id}     { allow read: if member(); allow write: if isStaff(); }
    match /studentSurveys/{id}    { allow read: if member(); allow write: if isStaff(); }
    match /studentStats/{id}      { allow read: if member(); allow write: if isStaff(); }
    match /teacherLessonLogs/{id} { allow read: if member(); allow write: if isStaff(); }
    match /qrSessions/{id}        { allow read: if member(); allow write: if isStaff(); }
    match /config/{id}            { allow read: if member(); allow write: if isStaff(); }
    match /admins/{id}            { allow read: if isStaff(); allow write: if isStaff(); }

    // ── Roller — personel her rolü yazabilir (kullanıcı oluşturma için);
    //    normal kullanıcı yalnızca KENDİ uid'ini yazar ve admin olamaz ──
    match /roles/{uid} {
      allow read:  if isStaff() || (authed() && request.auth.uid == uid);
      allow write: if isManager();
    }

    // ── Hem öğrenci hem personel okur/yazar ────────────────────────────
    //   attendance: öğrenci QR check-in + öğretmen yoklama kaydı
    //   messages / survey responses: öğrenci gönderir (istemci filtreli sorgular)
    //   devices: kullanıcı kendi cihaz kaydını yazar
    // Yoklama: personel her kaydı yazar; öğrenci yalnızca KENDİ adına QR girişi yazar (silemez)
    match /attendance/{id} {
      allow read: if member();
      allow create, update: if isStaff()
        || (isStudent()
            && string(request.resource.data.get('studentNo', '')) == prefix()
            && (resource == null || string(resource.data.get('studentNo', '')) == prefix()));
      allow delete: if isStaff();
    }
    match /messages/{id}               { allow read, write: if member(); }
    match /surveyResponses/{id}        { allow read, write: if member(); }
    match /studentSurveyResponses/{id} { allow read, write: if member(); }
    match /devices/{id}                { allow read, write: if member(); }

    // ════════════════════════════════════════════════════════════════════
    //  AKADEMIYA ZAROKAN (Çocuk Akademisi) — yalnızca VELİ girişi
    //    Veli : <no>@veli.aat  VE  idx_guardians/<no> mevcut
    //    Çocuğun kendi hesabı YOKTUR. Veli yalnızca guardianNos listesinde
    //    olduğu çocukları, onların yoklamasını ve kendi mesajlarını görür.
    //    Yetişkin öğrenci verisine (students, messages…) hiçbir erişimi yoktur.
    // ════════════════════════════════════════════════════════════════════
    function isGuardian() {
      return authed() && mail().matches('.*@veli[.]aat$') && exists(dbPath('idx_guardians'));
    }
    function myKid(d) { return isGuardian() && prefix() in d.guardianNos; }

    match /idx_guardians/{no} { allow read: if isStaff() || (authed() && prefix() == no); allow write: if isManager(); }

    // Başvuru dönemi (site girişsiz okur)
    match /config/zarok { allow read: if true; allow write: if isStaff(); }
    function zarokOpen() {
      return exists(/databases/$(database)/documents/config/zarok)
        && get(/databases/$(database)/documents/config/zarok).data.open == true;
    }
    function optStr(k, n) { return !(k in request.resource.data) || (request.resource.data[k] is string && request.resource.data[k].size() <= n); }

    // Veli başvurusu — girişsiz oluşturma, sıkı doğrulama
    match /kidApplications/{id} {
      allow create: if zarokOpen()
        && request.resource.data.keys().hasOnly(['kidName','kidDob','area','school','guardianName','relation',
             'phone','phone2','email','health','consentKvkk','consentPhoto','consentShare','docs','status','dateStr','createdAt','note'])
        && request.resource.data.kidName is string && request.resource.data.kidName.size() > 0 && request.resource.data.kidName.size() <= 80
        && request.resource.data.guardianName is string && request.resource.data.guardianName.size() > 0 && request.resource.data.guardianName.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 30
        && request.resource.data.consentKvkk == true
        && request.resource.data.status == 'new'
        && optStr('kidDob', 20) && optStr('area', 20) && optStr('school', 80) && optStr('relation', 30)
        && optStr('phone2', 30) && optStr('email', 80) && optStr('health', 500) && optStr('note', 500) && optStr('dateStr', 20)
        && (!('docs' in request.resource.data) || (request.resource.data.docs is list && request.resource.data.docs.size() <= 6));
      allow read, update, delete: if isStaff();
    }

    // Veli kaydı (doc id = veli no)
    match /guardians/{no} {
      allow read:  if isStaff() || (isGuardian() && prefix() == no);
      allow write: if isManager();
    }

    // Çocuk kaydı — veli yalnızca izin/teslim/sağlık alanlarını güncelleyebilir
    match /kids/{id} {
      allow read:   if isStaff() || myKid(resource.data);
      allow create, delete: if isManager();
      allow update: if isStaff()
        || (myKid(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pickups','consentPhoto','consentShare','health','updatedAt']));
    }

    // Giriş/çıkış yoklaması (öğretmen/öğrenci işleri yazar, veli okur)
    match /kidAttendance/{id} {
      allow read:  if isStaff() || myKid(resource.data);
      allow write: if isStaff();
    }

    match /kidSchedule/{id}      { allow read: if isStaff() || isGuardian(); allow write: if isStaff(); }
    match /kidAnnouncements/{id} { allow read: if isStaff() || isGuardian(); allow write: if isStaff(); }

    // Veli ↔ akademi mesajları
    match /kidMessages/{id} {
      allow read: if isStaff() || (isGuardian() && resource.data.guardianNo == prefix());
      allow create: if isStaff()
        || (isGuardian()
            && request.resource.data.keys().hasOnly(['guardianNo','guardianName','kidId','kidName','text','from','read','createdAt'])
            && request.resource.data.guardianNo == prefix()
            && request.resource.data.from == 'guardian'
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000);
      allow update, delete: if isStaff();
    }
  }
}
