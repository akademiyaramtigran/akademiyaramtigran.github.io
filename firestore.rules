rules_version = '2';

// ════════════════════════════════════════════════════════════════════════
//  Akademîya Aram Tîgran — Firestore Security Rules  (v5: rol ayrımı + en az yetki)
//  ----------------------------------------------------------------------
//  YAZMA: rol bazlı kilitli (önceki sürümle aynı).
//  OKUMA: artık varsayılan KAPALI.
//    • Öğrenci: yalnızca KENDİ students dokümanını okur (no == e-posta öneki).
//      Diğer öğrencileri ve öğretmen listesini (PII + şifre hash'i) OKUYAMAZ.
//    • Personel (@ogretmen.aat / admin): students + teachers dahil hepsini okur.
//    • Ortak koleksiyonlar (program, duyuru, anket, mesaj, yoklama, QR…):
//      giriş yapmış herkese açık (öğrenci paneli bunları kullanır).
//    • Site (girişsiz): yalnızca news, config/applications, applicationTemplates.
//
//  v4 — KİMLİK: e-posta uzantısı TEK BAŞINA yetki vermez.
//    Firebase Auth'ta herkes istemci API'siyle "x@ogretmen.aat" hesabı açabilir;
//    bu yüzden personel/öğrenci ayrıca personelin yazdığı DİZİNDE olmalıdır:
//    • Öğrenci   : <no>@ogrenci.aat   VE  idx_students/<no> mevcut
//    • Personel  : <no>@ogretmen.aat  VE  idx_staff/<no> mevcut
//                  (öğretmen / yönetici / basın / öğrenci işleri)
//    • Yönetici  : admin@aramtigran.edu (yedek, dizinden bağımsız)
//    Dizin, yönetici girişinde uygulama tarafından otomatik eşitlenir.
//
//  v5 — ROL AYRIMI (en az yetki):
//    • Yönetici (admin)          : her şey; personel dizini ve özel kartlar (basın / öğrenci işleri)
//    • Öğrenci İşleri (registrar): öğrenci + öğretmen kayıtları (yalnızca "teacher" seviyesi),
//                                  başvurular, Akademiya Zarokan yönetimi (çocuk/veli/öğretmen)
//    • Basın (press)             : yalnızca site haberleri + arşiv (ana site ve çocuk sitesi)
//    • Öğretmen (teacher)        : ders, yoklama, duyuru, anket; öğrenci ekleyebilir
//    • Bölüm sorumlusu (head)    : bölümünün raporlarını okur; yalnızca kendi bölümüne duyuru,
//                                  personele mesaj; öğrenciden mesaj alır (öğrenciye mesaj YAZAMAZ)
//    Hiçbir rol kendi seviyesini yükseltemez; basın/öğrenci işleri dizine "admin" yazamaz.
//    YAYIN SIRASI: önce yeni uygulama sürümü → yönetici bir kez giriş yapar →
//    Console'da idx_staff/idx_students dolu mu kontrol et → SONRA bu kuralları yayınla.
// ════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Yardımcılar ─────────────────────────────────────────────────────
    function authed()  { return request.auth != null && request.auth.token.email != null; }
    function mail()    { return request.auth.token.email; }
    function prefix()  { return mail().split('@')[0]; }
    function dbPath(c) { return /databases/$(database)/documents/$(c)/$(prefix()); }

    // Personel: dizinde kayıtlı öğretmen/yönetici (veya yedek admin hesabı)
    // (Kapı güvenlik görevlisi — lvl "gate" — personel SAYILMAZ: yalnızca kart doğrular)
    function isStaff() {
      return authed() && (
        mail() == 'admin@aramtigran.edu' ||
        (mail().matches('.*@ogretmen[.]aat$') && exists(dbPath('idx_staff'))
          && get(dbPath('idx_staff')).data.get('lvl', 'teacher') != 'gate')
      );
    }
    // Kapı güvenliği: yalnızca kart okutur (cards/{token} get) ve giriş kaydı yazar
    function isGate() {
      return authed() && mail().matches('.*@ogretmen[.]aat$') && exists(dbPath('idx_staff'))
        && get(dbPath('idx_staff')).data.get('lvl', 'teacher') == 'gate';
    }
    // Öğrenci: dizinde kayıtlı
    function isStudent() {
      return authed() && mail().matches('.*@ogrenci[.]aat$') && exists(dbPath('idx_students'));
    }
    // Personel seviyesi (idx_staff.lvl): admin · registrar · press · teacher
    function lvlIn(ls) {
      return mail() == 'admin@aramtigran.edu' ||
        (isStaff() && get(dbPath('idx_staff')).data.get('lvl', 'teacher') in ls);
    }
    function isAdmin()     { return authed() && lvlIn(['admin']); }
    function isRegistrar() { return authed() && lvlIn(['admin', 'registrar']); }   // hesap/başvuru yönetimi
    function isPress()     { return authed() && lvlIn(['admin', 'press']); }       // site haberleri + arşiv
    function isTeacherLvl(){ return authed() && mail() != 'admin@aramtigran.edu' && isStaff()
                                  && get(dbPath('idx_staff')).data.get('lvl', 'teacher') == 'teacher'; }
    // Bölüm sorumlusu (lvl "head"): kendi bölümünün raporlarını okur; yazabildiği tek şeyler
    // kendi bölümüne duyuru, öğrenci OLMAYAN personele mesaj ve gelen mesajın okundu işareti.
    function headLvl() {
      return authed() && mail().matches('.*@ogretmen[.]aat$') && exists(dbPath('idx_staff'))
        && get(dbPath('idx_staff')).data.get('lvl', 'teacher') == 'head';
    }
    function headArea() { return get(dbPath('idx_staff')).data.get('area', ''); }
    // Genel sorumlu (bölüm = "genel"): ana akademinin TÜM bölümleri
    function headGeneral() { return headLvl() && headArea() == 'genel'; }
    // Çocuk akademisi bölüm sorumlusu (bölüm = çocuk akademisi dersi)
    function kidHeadLvl() { return headLvl() && headArea() in ['solfej', 'ziman', 'teori', 'dalcroze', 'drama', 'enstruman']; }
    // Bir hedef listesi sorumlunun yetki alanında mı? (genel sorumlu: her bölüm)
    function headTargetsOk(ts) { return ts is list && ts.size() >= 1 && (headArea() == 'genel' || (ts.size() == 1 && ts[0] == headArea())); }
    // Personel yazması (bölüm sorumlusu HARİÇ)
    function staffW() { return isStaff() && !headLvl(); }
    // Geriye dönük ad: hesap yönetimi = admin + öğrenci işleri (basın DEĞİL)
    function isManager()   { return isRegistrar(); }
    // Özel yetki bayrağı taşımayan sıradan öğretmen kaydı
    function plainTeacher(d) {
      return d.get('isAdmin', false) != true && d.get('isPress', false) != true && d.get('isRegistrar', false) != true
        && d.get('isGate', false) != true && d.get('isHead', false) != true;
    }
    // Akademi üyesi (giriş yapmış + dizinde kayıtlı)
    function member() { return isStaff() || isStudent(); }

    // Kimlik alanları (id / fireId): değiştirilemez; eski kayıtta yoksa yalnız belgenin KENDİ kimliğiyle eklenebilir
    // (id değiştirilip başka öğrencinin yoklama satırına yazılmasın)
    function selfIdsOk(docId) {
      let n = request.resource.data; let o = resource.data;
      return (n.get('fireId', null) == o.get('fireId', null) || (!('fireId' in o) && n.get('fireId', null) == docId))
        // uygulama kaydederken id'yi yazmaz (kimlik = belge kimliği'ne düşer): silinmesi serbest, BAŞKA değere değişemez
        && (n.get('id', null) == o.get('id', null) || !('id' in n) || n.get('id', null) == docId);
    }
    // Kendi kaydında değiştirilemeyecek alanlar (alan, sınıf, burs, yetki bayrakları…)
    function selfEditOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['no','name','isAdmin','isPress','isRegistrar','isGate','isHead','area','classLevel','burs','scholarship','grade','regYear','status','role','cardToken',
         'uid','lvl','headArea']);
    }

    // Bir öğrenci/öğretmen dokümanı bu kullanıcıya mı ait? ("no" alanı = e-posta öneki)
    function ownsStudentDoc(d) { return isStudent() && mail() == d.no + '@ogrenci.aat'; }
    // Kendi personel kaydı (güvenlik görevlisi dahil) — e-posta Auth ile kanıtlı olduğundan güvenli
    function ownsTeacherDoc(d) { return authed() && mail() == d.no + '@ogretmen.aat'; }

    // Kendi kendine "admin" olmayı engelle (isAdmin alanı true yapılamaz)
    function notGrantingAdmin() {
      return !('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false;
    }
    // "no" alanı değiştirilemesin (kimliğini başkasınınkiyle değiştiremez)
    function noUnchanged() { return request.resource.data.no == resource.data.no; }

    // Başvuru dönemi açık mı? (public create yalnızca dönem açıkken)
    function applicationsOpen() {
      return exists(/databases/$(database)/documents/config/applications)
        && get(/databases/$(database)/documents/config/applications).data.open == true;
    }

    // ── Varsayılan: HER ŞEY KAPALI ──────────────────────────────────────
    // (Aşağıdaki kurallar okuma/yazmayı koleksiyon bazında açar.)
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Öğrenciler — okuma: personel VEYA kendi kaydı ──────────────────
    // (Öğrenci istemcisi yalnızca where("no","==",kendiNo) sorgusu yapar;
    //  bu sorgu kuralla kanıtlanabilir olduğundan çalışır.)
    match /students/{id} {
      allow read:   if isStaff() || ownsStudentDoc(resource.data);
      // Öğretmen yeni öğrenci ekleyebilir; düzenleme/silme öğrenci işleri + yönetici
      allow create: if isRegistrar() || isTeacherLvl();
      allow update: if isRegistrar()
                    || (ownsStudentDoc(resource.data) && noUnchanged() && notGrantingAdmin() && selfEditOk() && selfIdsOk(id));
      allow delete: if isRegistrar();   // öğrenci kendi kaydını silemez (silme talebi yönetime gider)
    }

    // ── Üyelik dizini — yalnızca personel yazar; kişi kendi kaydını okuyabilir ──
    // Personel dizini: yönetici her seviyeyi yazar; öğrenci işleri yalnızca "teacher" seviyesini
    // (kendi kaydına ve yönetici/basın/öğrenci işleri kayıtlarına dokunamaz)
    match /idx_staff/{no} {
      allow read: if isStaff() || (authed() && prefix() == no);
      allow create, update: if isAdmin()
        || (isRegistrar() && no != prefix()
            && request.resource.data.get('lvl', '') == 'teacher'
            && (resource == null || resource.data.get('lvl', 'teacher') == 'teacher'));
      allow delete: if isAdmin() || (isRegistrar() && no != prefix() && resource.data.get('lvl', 'teacher') == 'teacher');
    }
    match /idx_students/{no} { allow read: if isStaff() || (authed() && prefix() == no); allow write: if isRegistrar(); }

    // ── Öğretmenler / Yönetici — okuma: yalnızca personel ──────────────
    match /teachers/{id} {
      allow read:   if isStaff() || ownsTeacherDoc(resource.data);
      // Öğretmen kaydı açma/silme/başkasını düzenleme: yalnızca yönetici seviyesi.
      // Öğretmen kendi profilini (foto, telefon, e-posta, adres, bio, şifre) düzenleyebilir.
      // Özel kartlar (isAdmin / isPress / isRegistrar) yalnızca yöneticiden
      allow create: if isAdmin() || (isRegistrar() && plainTeacher(request.resource.data));
      allow update: if isAdmin()
                    || (isRegistrar() && plainTeacher(resource.data) && plainTeacher(request.resource.data))
                    || (ownsTeacherDoc(resource.data) && noUnchanged() && notGrantingAdmin() && selfEditOk() && selfIdsOk(id));
      allow delete: if isAdmin() || (isRegistrar() && plainTeacher(resource.data));
    }

    // ── Malper nûçe (ana sayfa haberleri) — HERKESE açık okuma ─────────
    match /news/{id} {
      allow read:  if true;
      allow write: if isPress();
    }

    // ── Arşîv (ana sayfa "Dîroka Akademiyê" zaman çizgisi) — açık okuma ─
    // Yönetici/basın panelinden girilen yıl bazlı kayıtlar; site girişsiz okur.
    match /archive/{id} {
      allow read:  if true;
      allow write: if isPress();
    }

    // ── Serlêdan (kayıt başvuruları) — public create, sıkı sınırlı ─────
    match /applications/{id} {
      allow create: if applicationsOpen()
                    && request.resource.data.keys().hasOnly(
                      ['name','phone','dob','area','note','docs','status','dateStr','createdAt','email','kvkk'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() <= 30
                    && (!('dob'  in request.resource.data) || request.resource.data.dob.size()  <= 20)
                    && (!('area' in request.resource.data) || request.resource.data.area.size() <= 20)
                    && (!('note' in request.resource.data) || request.resource.data.note.size() <= 500)
                    && (!('email' in request.resource.data) || request.resource.data.email.size() <= 80)
                    && (!('dateStr' in request.resource.data) || request.resource.data.dateStr.size() <= 20)
                    && request.resource.data.status == 'new'
                    && request.resource.data.docs is list
                    && request.resource.data.docs.size() <= 8;
      allow read, update, delete: if isRegistrar();
    }
    // Başvuru dönemi ayarı — site (girişsiz) okuyabilsin, yazma öğrenci işleri
    match /config/applications {
      allow read:  if true;
      allow write: if isRegistrar();
    }
    // İstenen belgeler (şablonlar) — herkes görebilsin (indirir), yazma öğrenci işleri
    match /applicationTemplates/{id} {
      allow read:  if true;
      allow write: if isRegistrar();
    }

    // ── Ortak koleksiyonlar — okuma: giriş yapmış herkes ───────────────
    // (öğrenci paneli program/duyuru/anket/QR okur; yazma personel)
    // Ders programı: yönetici ve Öğrenci İşleri her dersi; bölüm sorumlusu yalnız KENDİ bölümünün derslerini ekler/düzenler/siler
    // (genel sorumlu: ana akademinin bütün dersleri). Atölye dersini (ws_<sınıf>) kendi bölümünün sorumlusu yazar.
    // Öğretmen programı DEĞİŞTİREMEZ (yalnız okur, yoklama alır).
    function aatHead() { return headLvl() && !kidHeadLvl(); }
    // Bölüm sorumlusu AYNI ZAMANDA öğretmen olabilir (derse atanır, yoklama alır): ana akademide her sorumlu, öğretmen
    // yetkisiyle yazar; çocuk akademisinde Öğrenci İşleri sorumluyu çocuk akademisine bağlarsa (idx_kidstaff) kidStaff olur.
    function tchW() { return staffW() || aatHead(); }
    function headSchedWrite() {
      // bölüm sorumlusu yalnız kendi bölümünün programı; genel sorumlu yalnız GENEL alanın (ortak dersler / genel sınıf)
      return aatHead() && request.resource.data.get('area', '') == headArea()
        && (resource == null || resource.data.get('area', '') == headArea());
    }
    match /schedule/{id} {
      allow read: if member();
      // Ders programı: yönetici (hepsi) + bölüm sorumlusu (kendi bölümü; genel sorumlu hepsi). Atölye dersini (ws_) de bölüm sorumlusu yazar; Öğrenci İşleri program yazmaz.
      allow create, update: if isAdmin() || headSchedWrite();
      allow delete: if isAdmin() || (aatHead() && resource.data.get('area', '') == headArea());
    }
    // Sınıflar: öğrencinin sınıfı students.classLevel; sınıf öğretmeni burada (doc id = <alan>_<seviye>)
    // Sınıflar: bölüm sorumlusu KENDİ bölümünün sınıflarını açar / düzenler (genel sorumlu: bütün bölümlerin + genel sınıflar);
    // Öğrenci İşleri yalnız atölyeleri (bölümler arası gruplar); yönetici hepsini
    function headClassOk(d) {
      // bölüm sorumlusu: yalnız KENDİ bölümünün sınıfı; genel sorumlu: yalnız GENEL sınıf (bütün öğrencilerden oluşan), başka bir şeye karışmaz
      // atölye = bölüm sorumlusunun "atölye" diye işaretlediği KENDİ bölüm sınıfı (kind 'area', workshop: true)
      return aatHead() && ((d.get('kind', '') == 'area' && !headGeneral() && d.get('area', '') == headArea())
                           || (headGeneral() && d.get('kind', '') == 'general'));
    }
    match /classes/{id} {
      allow read: if member();
      allow create: if isAdmin() || headClassOk(request.resource.data);
      allow update: if isAdmin()
                    || (headClassOk(resource.data) && headClassOk(request.resource.data));
      allow delete: if isAdmin() || headClassOk(resource.data);
    }
    // Sınıf paylaşımları (duyuru/ödev/belge): öğretmen YALNIZCA sınıf öğretmeni olduğu sınıfa, kendi adıyla yazar
    function clsDoc(c, id) { return /databases/$(database)/documents/$(c)/$(id); }
    // Sınıfa paylaşım: sınıf öğretmeni YA DA o sınıfa bağlı dersi veren öğretmen (lessonId ile kanıtlar)
    function teachesClassLesson(sc) {
      return request.resource.data.get('lessonId', '') is string && request.resource.data.get('lessonId', '') != ''
        && exists(clsDoc(sc, request.resource.data.lessonId))
        && get(clsDoc(sc, request.resource.data.lessonId)).data.get('classId', '') == request.resource.data.classId
        && string(get(clsDoc(sc, request.resource.data.lessonId)).data.get('teacherNo', '')) == prefix();
    }
    function classPostOk(c, sc) {
      return request.resource.data.teacherNo == prefix()
        && request.resource.data.classId is string
        && exists(clsDoc(c, request.resource.data.classId))
        && (prefix() in get(clsDoc(c, request.resource.data.classId)).data.get('teacherNos', []) || teachesClassLesson(sc))
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 140
        && request.resource.data.type in ['duyuru', 'odev', 'belge']
        // İsteğe bağlı: yalnız seçilen öğrenciler (öğrenci numaraları, 1–60)
        && (!('studentNos' in request.resource.data)
            || (request.resource.data.studentNos is list && request.resource.data.studentNos.size() >= 1 && request.resource.data.studentNos.size() <= 60));
    }
    // Bölüm sorumlusu kendi bölümünün (genel sorumlu: genel) sınıflarına duyuru / ödev / belge yazar (önce denenir: kural değerlendirme sınırı)
    function headClassPostOk() {
      let d = request.resource.data;
      return aatHead() && d.teacherNo == prefix() && d.classId is string
        && d.title is string && d.title.size() > 0 && d.title.size() <= 140
        && d.type in ['duyuru', 'odev', 'belge']
        && d.get('priv', false) == ('studentNos' in d)
        && (!('studentNos' in d) || (d.studentNos is list && d.studentNos.size() >= 1 && d.studentNos.size() <= 60))
        && exists(clsDoc('classes', d.classId)) && headClassOk(get(clsDoc('classes', d.classId)).data);
    }
    // Öğrenci: sınıf geneli paylaşım (priv == false) ya da kendisine gönderilen (studentNos içinde)
    match /classPosts/{id} {
      allow read: if isStaff()
        || (isStudent() && (resource.data.get('priv', true) == false || prefix() in resource.data.get('studentNos', [])));
      allow create: if headClassPostOk() || (isRegistrar() || (tchW() && classPostOk('classes', 'schedule')))
        && request.resource.data.get('priv', false) == ('studentNos' in request.resource.data);
      allow update: if isRegistrar();
      allow delete: if isRegistrar() || (isStaff() && resource.data.teacherNo == prefix());
    }
    // Duyuru: bölüm sorumlusu yalnızca KENDİ adıyla ve YALNIZCA kendi bölümüne
    function headAnnOk(d) {
      return d.get('senderRole', '') == 'head' && d.get('senderNo', '') == prefix() && !kidHeadLvl()
        && headTargetsOk(d.get('targets', [])) && d.get('senderArea', '') == headArea();
    }
    // Sıradan öğretmen alan geneline duyuru YAZAMAZ: yalnızca kendi sınıflarına (classPosts type "duyuru")
    match /announcements/{id} {
      allow read: if member();
      allow create: if (staffW() && !isTeacherLvl()) || (headLvl() && headAnnOk(request.resource.data));
      allow update: if (staffW() && !isTeacherLvl()) || (headLvl() && headAnnOk(resource.data) && headAnnOk(request.resource.data));
      allow delete: if (staffW() && !isTeacherLvl()) || (headLvl() && headAnnOk(resource.data));
    }
    // Anketler kaldırıldı (yalnız değerlendirme formları kullanılıyor): okuma/yazma kapalı
    match /studentSurveys/{id}         { allow read, write: if false; }
    match /studentSurveyResponses/{id} { allow read, write: if false; }
    match /surveyResponses/{id}        { allow read, write: if false; }
    // Eski devam istatistiği tablosu KALDIRILDI (devam yoklama belgelerinden hesaplanır); kalan belgeler temizlikte silinir
    match /studentStats/{id}      { allow read, delete: if isAdmin(); allow create, update: if false; }
    match /teacherLessonLogs/{id} { allow read: if isStaff(); allow write: if tchW(); }
    match /qrSessions/{id}        { allow read: if member(); allow write: if tchW(); }
    // Dönen QR kodları ayrı belgede: öğrenci OKUYAMAZ (uzaktan okutma olmasın); doğrulamayı kural yapar
    match /qrCodes/{id}           { allow read, write: if tchW(); }
    match /config/{id}            { allow read: if member() && id != 'reportArchive'; allow write: if isRegistrar(); }
    match /config/reportArchive   { allow read, write: if isStaff(); }
    match /admins/{id}            { allow read: if isStaff(); allow write: if isAdmin(); }

    // ── Roller — personel her rolü yazabilir (kullanıcı oluşturma için);
    //    normal kullanıcı yalnızca KENDİ uid'ini yazar ve admin olamaz ──
    match /roles/{uid} {
      allow read:  if isStaff() || (authed() && request.auth.uid == uid);
      allow write: if isRegistrar();
    }

    // ── Hem öğrenci hem personel okur/yazar ────────────────────────────
    //   attendance: öğrenci QR check-in + öğretmen yoklama kaydı
    //   messages / survey responses: öğrenci gönderir (istemci filtreli sorgular)
    //   devices: kullanıcı kendi cihaz kaydını yazar
    // Yoklama: personel her kaydı yazar; öğrenci yalnızca KENDİ adına QR girişi yazar (silemez)
    // Yoklama: öğretmen yetkisi olanlar (sıradan öğretmen + öğretmen olarak görev yapan bölüm sorumlusu = tchW) her ders belgesini yazar;
    // öğrenci yalnızca KENDİ adına QR girişi yazar (silemez)
    // Öğrenci izni: bölüm sorumlusu kendi bölümünün öğrencisine (çocuk akademisi sorumlusu kendi dersinin
    // çocuğuna) izin işler; izinli öğrenci yoklama listesinde görünmez. Yönetici her izni işler/siler.
    function leaveOk(d) {
      return d.keys().hasOnly(['studentNo', 'studentId', 'studentName', 'area', 'from', 'to', 'reason', 'by', 'byNo', 'kid', 'createdAt', 'lessonIds', 'lessonNames'])
        && d.studentNo is string && d.from is string && d.to is string && d.from <= d.to
        && (!('lessonIds' in d) || (d.lessonIds is list && d.lessonIds.size() <= 20))
        && (!('lessonNames' in d) || (d.lessonNames is list && d.lessonNames.size() <= 20))
        && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 300
        && d.kid is bool && d.byNo == prefix();
    }
    match /studentLeaves/{id} {
      allow read: if isStaff() || kidRead();
      allow create: if leaveOk(request.resource.data) && (isAdmin()
        || (request.resource.data.kid == true && kidHeadLvl() && request.resource.data.area == headArea())
        || (request.resource.data.kid == false && aatHead() && (headGeneral() || request.resource.data.area == headArea())));
      allow delete: if isAdmin() || (headLvl() && resource.data.byNo == prefix());
    }
    // Öğrenci QR okutması: yalnız KENDİ adına, açık ve süresi dolmamış bir oturuma, belge kimliği oturumla başlar;
    // ders yoklamasına (records) / ders kaydına DOKUNAMAZ. Ekrandaki dönen kod (son ~90 sn) kural tarafından doğrulanır,
    // "geç" işareti oturumun başlangıcına göre (±1 dk tolerans), ders/tarih oturumla aynı olmalı.
    function qrSess(sid) { return get(/databases/$(database)/documents/qrSessions/$(sid)).data; }
    function qrCodeOk(sid, c) {
      return (exists(/databases/$(database)/documents/qrCodes/$(sid)) && c in get(/databases/$(database)/documents/qrCodes/$(sid)).data.get('codes', []))
        || (c != '' && c in qrSess(sid).get('codes', []))                   // eski sürüm öğretmen uygulaması (geçiş)
        || (c == '' && request.time < timestamp.date(2026, 11, 17));       // eski sürüm öğrenci uygulaması: 1 haftalık geçiş
    }
    function qrLateOk(sid, l) {
      // "zamanında" yalnız dersin açılışından sonraki ilk 16 dk (1 dk saat payı); "geç" her zaman yazılabilir
      return l == true || (l == false && request.time.toMillis() - qrSess(sid).get('openedAtMs', 0) < 960000);
    }
    // Okutan öğrenci kaydı GERÇEKTEN kendisi mi? (studentId başkasınınki yazılıp onun adına yoklama verilemez)
    function stuSelfOk(id, sid, d) {
      let f = d.get('studentFire', '');
      return f is string && f != '' && exists(/databases/$(database)/documents/students/$(f))
        && string(get(/databases/$(database)/documents/students/$(f)).data.get('no', '')) == prefix()
        && string(get(/databases/$(database)/documents/students/$(f)).data.get('id', f)) == string(d.get('studentId', ''))
        && id == sid + '_' + string(d.get('studentId', ''));
    }
    function stuQrOk(id) {
      let d = request.resource.data;
      let sid = d.get('sessionId', '');
      return isStudent() && sid is string && sid != '' && id.split('_')[0] == sid
        && string(d.get('studentNo', '')) == prefix()
        && (resource == null || string(resource.data.get('studentNo', '')) == prefix())
        && exists(/databases/$(database)/documents/qrSessions/$(sid))
        && qrSess(sid).get('active', false) == true && qrSess(sid).get('expiresAt', 0) > request.time.toMillis()
        && (d.get('deviceClaim', false) == true
            ? d.keys().hasOnly(['sessionId', 'studentNo', 'deviceClaim', 'time'])
            : (d.keys().hasOnly(['sessionId', 'lessonName', 'area', 'studentId', 'studentFire', 'studentName', 'studentNo', 'qrLessonId', 'qrDate', 'time', 'late', 'teacherName', 'code'])
               && stuSelfOk(id, sid, d)
               && qrCodeOk(sid, d.get('code', ''))
               && qrLateOk(sid, d.get('late', false))
               && (!('qrLessonId' in d) || (d.qrLessonId == qrSess(sid).get('lessonId', '') && d.get('qrDate', '') == qrSess(sid).get('lessonDate', '')))));
    }
    // Öğrenci devam kaydı: sunucu (Cloud Functions) yoklama kaydedilince yazar; öğrenci yalnız KENDİ kayıtlarını okur, değiştiremez
    match /studentAtt/{id} {
      allow read: if isStaff() || (isStudent() && resource.data.get('studentNo', '') == prefix());
      allow write: if false;
    }
    // Yoklama itirazı: öğrenci yalnız KENDİ "yok/geç" kaydı için, notla, bir kez; sunucu öğretmene/sorumluya/yönetime mesaj düşürür
    match /attObjections/{id} {
      allow read: if isStaff() || (isStudent() && resource.data.get('studentNo', '') == prefix());
      allow create: if isStudent()
        && request.resource.data.keys().hasOnly(['studentNo', 'studentName', 'lessonId', 'lessonFire', 'lessonName', 'area', 'date', 'status', 'note', 'createdAt'])
        && request.resource.data.studentNo == prefix()
        && id == request.resource.data.lessonId + '-' + request.resource.data.date + '-' + prefix()
        && request.resource.data.note is string && request.resource.data.note.size() >= 3 && request.resource.data.note.size() <= 300
        && string(request.resource.data.get('studentName', '')).size() <= 120 && string(request.resource.data.get('lessonName', '')).size() <= 120
        && exists(/databases/$(database)/documents/studentAtt/$(id))
        && get(/databases/$(database)/documents/studentAtt/$(id)).data.studentNo == prefix()
        && get(/databases/$(database)/documents/studentAtt/$(id)).data.status in ['off', 'late']
        && get(/databases/$(database)/documents/studentAtt/$(id)).data.status == request.resource.data.status;
      allow delete: if isRegistrar();
    }
    // ── Yoklama yetkisi: dersin öğretmeni / o günün görevlisi / dersin bölüm sorumlusu ──
    function schedPath(lf) { return /databases/$(database)/documents/schedule/$(lf); }
    function attLessonOk(id) {
      let d = request.resource.data;
      let lf = d.get('lessonFire', '');
      let dt = d.get('date', '');
      return (staffW() || aatHead()) && lf is string && lf != '' && dt is string && dt != ''
        && ((exists(schedPath(lf)) && string(get(schedPath(lf)).data.get('teacherNo', '')) == prefix())
            || (exists(/databases/$(database)/documents/lessonSubs/$(lf + '_' + dt))
                && string(get(/databases/$(database)/documents/lessonSubs/$(lf + '_' + dt)).data.get('teacherNo', '')) == prefix()));
    }
    function attHeadOk() {
      let lf = request.resource.data.get('lessonFire', '');
      return aatHead() && !headGeneral() && lf is string && lf != ''
        && exists(schedPath(lf)) && get(schedPath(lf)).data.get('area', '') == headArea();
    }
    // Yönetici: yalnız "ders yapılmadı" (teacherAbsent) işareti — öğrenci kayıtları (records) değişmez
    function attAbsentOnlyOk() {
      return isAdmin() && request.resource.data.keys().hasAny(['teacherAbsent'])
        && request.resource.data.get('records', {}) == (resource == null ? {} : resource.data.get('records', {}));
    }
    // Günlük görevlendirme: dersin bölüm sorumlusu, belirli bir tarih için (asıl öğretmen değişmez) başka bir öğretmeni / kendini görevlendirir
    match /lessonSubs/{id} {
      allow read: if isStaff();
      allow create, update: if aatHead() && request.resource.data.keys().hasOnly(['lessonFire', 'date', 'teacherNo', 'teacherName', 'area', 'byNo', 'updatedAt'])
        && id == request.resource.data.get('lessonFire', '') + '_' + request.resource.data.get('date', '')
        && request.resource.data.get('teacherNo', '') is string && request.resource.data.get('teacherNo', '') != ''
        && exists(schedPath(request.resource.data.get('lessonFire', '')))
        && get(schedPath(request.resource.data.get('lessonFire', ''))).data.get('area', '') == headArea();
      allow delete: if aatHead() && exists(schedPath(resource.data.get('lessonFire', '')))
        && get(schedPath(resource.data.get('lessonFire', ''))).data.get('area', '') == headArea();
    }
    match /attendance/{id} {
      // Öğrenci yalnız KENDİ QR okutma kaydını okur (başkalarının yoklaması kişisel veridir)
      allow read: if isStaff() || (isStudent() && string(resource.data.get('studentNo', '')) == prefix());
      // Sıra önemli: sorumlunun yoklama düzeltmesi (headLessonAttOk) headAbsenceOk'tan ÖNCE denenir — güncellemede
      // headAbsenceOk'un fark hesabı kural değerlendirme sınırını aşıp meşru düzeltmeyi reddettiriyordu.
      // Yoklamayı YALNIZ dersin öğretmeni, o günün görevlendirilen öğretmeni (lessonSubs) ve dersin bölüm sorumlusu yazar/düzeltir.
      // Genel sorumlu bölüm sorumlusu olarak yoklama düzeltemez (yalnız öğretmen ya da görevli olarak alır); yönetici ve Öğrenci İşleri yazamaz
      // (yönetici yalnız "ders yapılmadı" işaretini koyabilir, öğrenci kayıtlarına dokunamaz).
      allow create, update: if attLessonOk(id) || attHeadOk() || attAbsentOnlyOk() || stuQrOk(id);
      // Silme yalnız yönetici + öğrenci işleri (ders silinirken kayıtları); öğretmen geçmiş yoklamayı silip izini kaybettiremez
      // Silme: yönetici; bölüm sorumlusu kendi bölümünün (genel sorumlu hepsinin) ders kayıtlarını (ders silinirken);
      allow delete: if isAdmin()
        || (aatHead() && resource.data.get('area', '') == headArea());
    }
    // Mesajlar: personel hepsini okur/yazar. Öğrenci yalnızca KENDİNE gelen özel mesajı
    // (recipientNo == kendi no) ve öğrencilere yönelik toplu mesajları okur; yalnızca
    // yönetime/öğretmene "öğrenci" olarak yazabilir (yönetici adına veya toplu mesaj atamaz).
    // Bölüm mesajı (area_X) yalnız o bölümün öğrencisine: bölüm, üyelik dizinindeki (idx_students.area) kayıttan okunur.
    // Dizin kaydında bölüm henüz yoksa (yönetici girişinde eşitlenene kadar) geçiş için eskisi gibi açık kalır.
    function studentGroup(d) {
      let g = string(d.get('recipientGroup', ''));
      return g in ['allStudents', 'all']
        || (g.matches('area_[a-z]+') && (get(dbPath('idx_students')).data.get('area', null) == null
              || g == 'area_' + get(dbPath('idx_students')).data.get('area', '')));
    }
    // Bölüm sorumlusunun mesajı: kendi adıyla, tek alıcıya; alıcı yönetici ya da ÖĞRENCİ OLMAYAN personel
    // (öğrencilere yalnızca duyuru gönderir)
    function headMsgOk(d) {
      return d.get('fromType', '') == 'head' && d.get('senderNo', '') == prefix()
        && d.get('recipientGroup', null) == null
        && ((d.get('recipientId', '') == 'admin' && d.get('recipientNo', null) == null)
            || (d.get('recipientNo', null) is string && d.get('recipientNo', '') != ''
                && exists(/databases/$(database)/documents/idx_staff/$(d.get('recipientNo', ''))))
            || headReplyOk(d))
        && string(d.get('body', '')).size() <= 5000 && string(d.get('subject', '')).size() <= 300;
    }
    // Sorumlunun öğrenciye CEVABI: yalnızca o öğrencinin sorumluya (bu bölüme) yazdığı mesaja
    function origMsg(d) { return get(/databases/$(database)/documents/messages/$(d.replyTo)).data; }
    function headReplyOk(d) {
      return d.get('replyTo', '') is string && d.get('replyTo', '') != ''
        && exists(/databases/$(database)/documents/messages/$(d.get('replyTo', '')))
        && origMsg(d).get('toRole', '') == 'head'
        && (origMsg(d).get('toArea', '') == headArea())
        && origMsg(d).get('fromNo', '') != '' && origMsg(d).get('fromNo', '') == d.get('recipientNo', '');
    }
    // Öğretmen olarak görev yapan bölüm sorumlusu: öğrencisine / yönetime öğretmen mesajı (kendi adına, toplu grup yok)
    function headTeacherMsgOk(d) {
      return aatHead() && d.get('fromType', '') == 'teacher' && d.get('senderId', '') != 'admin'
        && d.get('recipientGroup', null) == null
        && (d.get('recipientId', '') == 'admin'
            || (d.get('recipientNo', null) is string && exists(/databases/$(database)/documents/idx_students/$(d.get('recipientNo', '')))))
        && string(d.get('body', '')).size() <= 5000 && string(d.get('subject', '')).size() <= 300;
    }
    // Bölüm sorumlusunun SINIFINA / sınıftan seçilen öğrencilere mesajı: sınıf kendi bölümünün (genel sorumlu: genel) sınıfı, alıcı o sınıfın öğrencisi
    function headStudentMsgOk(d) {
      return aatHead() && d.get('fromType', '') == 'head' && d.get('senderNo', '') == prefix()
        && d.get('recipientGroup', null) == null
        && d.get('classId', null) is string && d.get('recipientNo', null) is string
        && string(d.get('body', '')).size() <= 5000 && string(d.get('subject', '')).size() <= 300
        && exists(/databases/$(database)/documents/classes/$(d.classId))
        && headStuInClass(get(/databases/$(database)/documents/classes/$(d.classId)).data, d.recipientNo);
    }
    function headStuInClass(c, no) { return headClassOk(c) && no in c.get('studentNos', []); }
    // Kişisel silme: kullanıcı kendi gelen/giden mesaj ve duyurularını yalnız KENDİ listesinden gizler
    match /userHidden/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['msgs', 'anns', 'posts'])
        && request.resource.data.get('msgs', []).size() <= 1000
        && request.resource.data.get('anns', []).size() <= 1000
        && request.resource.data.get('posts', []).size() <= 1000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /messages/{id} {
      allow read: if isStaff()
        || (isStudent() && (resource.data.get('recipientNo', '') == prefix() || studentGroup(resource.data)
            || resource.data.get('fromNo', '') == prefix()));
      allow create: if staffW()
        || (headLvl() && headMsgOk(request.resource.data))
        || headStudentMsgOk(request.resource.data)
        || headTeacherMsgOk(request.resource.data)
        || (isStudent()
            && request.resource.data.get('fromType', '') == 'student'
            && request.resource.data.get('senderId', '') != 'admin'
            && request.resource.data.get('recipientGroup', null) == null
            && request.resource.data.get('recipientNo', null) == null
            && request.resource.data.get('toRole', '') in ['admin', 'teacher', 'head']
            // gönderen numarası kendi numarası olmalı; numarasız mesaj yalnız "isimsiz" işaretli olabilir
            && (request.resource.data.get('fromNo', '') == prefix()
                || (!('fromNo' in request.resource.data) && request.resource.data.get('anonymous', false) == true
                    && request.resource.data.get('fromId', null) == null))
            && string(request.resource.data.get('body', '')).size() <= 5000
            && string(request.resource.data.get('subject', '')).size() <= 300);
      allow update: if staffW()
        || ((headLvl() || (isStudent() && resource.data.get('recipientNo', '') == prefix()))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']));
      // Bölüm sorumlusu kendi gelen kutusundaki (kendisine / kendi bölümüne gelen) ve gönderdiği mesajları silebilir
      allow delete: if staffW()
        || (headLvl() && (resource.data.get('recipientNo', '') == prefix() || resource.data.get('senderNo', '') == prefix()
            || (resource.data.get('toRole', '') == 'head' && resource.data.get('toArea', '') == headArea())));
    }
    // Değerlendirme formları (sorumlunun hazırladığı, 1–10 puan + yazılı sorular)
    //  academy "aat": t2s (öğretmen → öğrenci) · s2t (öğrenci → öğretmen, isimsiz)
    //  academy "kid": t2k (öğretmen → çocuk) · g2t (veli → öğretmen, isimsiz)
    function formOwnerOk(d) {
      return d.get('ownerNo', '') == prefix() && (
        (aatHead() && d.get('academy', '') == 'aat' && d.get('direction', '') in ['t2s', 's2t'] && (headGeneral() || d.get('area', '') == headArea()))
        || (kidHeadLvl() && d.get('academy', '') == 'kid' && d.get('direction', '') in ['t2k', 'g2t'] && d.get('area', '') == headArea()));
    }
    function formShapeOk(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.questions is list && d.questions.size() >= 1 && d.questions.size() <= 30
        && d.period in ['weekly', 'monthly', 'once'] && d.active is bool;
    }
    match /evalForms/{id} {
      allow read: if member() || isGuardian() || kidStaff();
      allow create: if formShapeOk(request.resource.data) && (isAdmin() || formOwnerOk(request.resource.data));
      allow update: if formShapeOk(request.resource.data) && (isAdmin() || (formOwnerOk(resource.data) && formOwnerOk(request.resource.data)));
      allow delete: if isAdmin() || formOwnerOk(resource.data);
    }
    function evForm(fid) { return get(/databases/$(database)/documents/evalForms/$(fid)).data; }
    function evRoleOk(dir) {
      return (dir == 't2s' && (isTeacherLvl() || aatHead())) || (dir == 's2t' && isStudent())
        || (dir == 't2k' && kidTeach()) || (dir == 'g2t' && isGuardian());
    }
    // Form cevabı: yalnız KENDİ adına, aktif forma, formun yönüne uygun rolle; belge kimliği form_dönem_değerlendiren_hedef
    match /evalResponses/{id} {
      allow read: if isAdmin() || headLvl() || (authed() && resource.data.raterNo == prefix());
      allow create, update: if authed()
        && request.resource.data.raterNo == prefix()
        && id == request.resource.data.formId + '_' + request.resource.data.period + '_' + prefix() + '_' + request.resource.data.targetNo
        && (resource == null || resource.data.raterNo == prefix())
        && request.resource.data.keys().hasOnly(['formId', 'period', 'raterNo', 'raterRole', 'targetNo', 'targetName', 'area', 'classId', 'academy', 'direction', 'answers', 'notes', 'score10', 'at'])
        && request.resource.data.answers is map && request.resource.data.answers.size() <= 30
        && (!('notes' in request.resource.data) || (request.resource.data.notes is map && request.resource.data.notes.size() <= 30))
        && (request.resource.data.score10 == null || (request.resource.data.score10 is number && request.resource.data.score10 >= 1 && request.resource.data.score10 <= 10))
        && exists(/databases/$(database)/documents/evalForms/$(request.resource.data.formId))
        && evForm(request.resource.data.formId).active == true
        && request.resource.data.direction == evForm(request.resource.data.formId).direction
        && evRoleOk(evForm(request.resource.data.formId).direction)
        && request.resource.data.get('academy', '') == evForm(request.resource.data.formId).get('academy', '')
        && request.resource.data.targetNo is string && request.resource.data.targetNo.size() <= 20
        && string(request.resource.data.get('area', '')).size() <= 40
        && string(request.resource.data.get('targetName', '')).size() <= 120
        // hedef GERÇEK bir kişi olmalı (öğrenci → kayıtlı öğretmen, öğretmen → kayıtlı öğrenci)
        && (request.resource.data.direction != 's2t' || (exists(/databases/$(database)/documents/idx_staff/$(request.resource.data.targetNo))
            && get(/databases/$(database)/documents/idx_staff/$(request.resource.data.targetNo)).data.get('lvl', 'teacher') != 'head'))
        && (request.resource.data.direction != 't2s' || exists(/databases/$(database)/documents/idx_students/$(request.resource.data.targetNo)));
      allow delete: if isAdmin();
    }
    // Uyarı merkezi: "ilgilenildi" işaretleri (yönetici + bölüm sorumlusu); belge kimliği = uyarı anahtarı
    match /alertAcks/{id} {
      allow read: if isAdmin() || headLvl();
      allow create, update: if (isAdmin() || (headLvl() && request.resource.data.byNo == prefix()))
        && request.resource.data.keys().hasOnly(['key', 'kind', 'count', 'note', 'by', 'byNo', 'at'])
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.count is int && request.resource.data.count >= 1;
      allow delete: if isAdmin();
    }
    // Eski haftalık değerlendirme (ana akademi) KALDIRILDI: değerlendirme yalnız sorumlunun formlarıyla (evalResponses).
    // Kalan eski veriler temizlik iş akışıyla silinir; kimse yazamaz, yalnız yönetici okur/siler.
    match /studentEvals/{id} { allow read, delete: if isAdmin(); allow create, update: if false; }
    match /teacherEvals/{id} { allow read, delete: if isAdmin(); allow create, update: if false; }
    // Cihaz kaydı: doküman kimliği = kullanıcı no; herkes yalnızca kendi cihazını
    match /devices/{no} {
      allow read: if isStaff() || (member() && prefix() == no);
      allow write: if staffW() || (member() && prefix() == no);
    }

    // ════════════════════════════════════════════════════════════════════
    //  AKADEMIYA ZAROKAN (Çocuk Akademisi) — yalnızca VELİ girişi
    //    Veli : <no>@veli.aat  VE  idx_guardians/<no> mevcut
    //    Çocuğun kendi hesabı YOKTUR. Veli yalnızca guardianNos listesinde
    //    olduğu çocukları, onların yoklamasını ve kendi mesajlarını görür.
    //    Yetişkin öğrenci verisine (students, messages…) hiçbir erişimi yoktur.
    // ════════════════════════════════════════════════════════════════════
    function isGuardian() {
      return authed() && mail().matches('.*@veli[.]aat$') && exists(dbPath('idx_guardians'));
    }
    function myKid(d) { return isGuardian() && prefix() in d.guardianNos; }
    // Çocuk akademisi öğretmeni: <no>@zmamoste.aat VE idx_kidstaff/<no>
    // (yetişkin akademinin öğrenci/öğretmen verisine ERİŞEMEZ)
    function isKidTeacher() {
      return authed() && mail().matches('.*@zmamoste[.]aat$') && exists(dbPath('idx_kidstaff'));
    }
    // Çocuk tarafında personel: yönetici / öğrenci işleri, çocuk öğretmeni VEYA
    // Öğrenci İşleri'nin çocuk akademisine bağladığı akademi öğretmeni (idx_kidstaff/<no>)
    function kidStaff() {
      return isRegistrar() || isKidTeacher()
        || (isStaff() && exists(dbPath('idx_kidstaff')));
    }
    // Çocuk tarafını OKUYABİLEN: personel + çocuk akademisi bölüm sorumlusu (yazma ayrı kurallarla)
    function kidRead() { return kidStaff() || kidHeadLvl(); }

    match /idx_guardians/{no} { allow read: if isStaff() || (authed() && prefix() == no); allow write: if isRegistrar(); }
    match /idx_kidstaff/{no}  { allow read: if isStaff() || (authed() && prefix() == no); allow write: if isRegistrar(); }

    // Çocuk akademisi öğretmen kayıtları (doc id = öğretmen no)
    match /kidTeachers/{no} {
      allow read:  if kidRead();
      allow write: if isRegistrar();
    }
    // Çocuk akademisi sitesi: haberler ve arşiv (tarih) — herkese açık okuma, yazma BASIN
    match /kidNews/{id}    { allow read: if true; allow write: if isPress(); }
    match /kidArchive/{id} { allow read: if true; allow write: if isPress(); }

    // Başvuru dönemi (site girişsiz okur)
    match /config/zarok { allow read: if true; allow write: if isRegistrar(); }
    // İstenen belgeler (şablonlar) — site girişsiz görür/indirir, yazma öğrenci işleri
    match /kidApplicationTemplates/{id} { allow read: if true; allow write: if isRegistrar(); }
    function zarokOpen() {
      return exists(/databases/$(database)/documents/config/zarok)
        && get(/databases/$(database)/documents/config/zarok).data.open == true;
    }
    function optStr(k, n) { return !(k in request.resource.data) || (request.resource.data[k] is string && request.resource.data[k].size() <= n); }

    // Veli başvurusu — girişsiz oluşturma, sıkı doğrulama
    match /kidApplications/{id} {
      allow create: if zarokOpen()
        && request.resource.data.keys().hasOnly(['kidName','kidDob','area','school','guardianName','relation',
             'phone','phone2','email','health','consentKvkk','consentPhoto','consentShare','docs','status','dateStr','createdAt','note'])
        && request.resource.data.kidName is string && request.resource.data.kidName.size() > 0 && request.resource.data.kidName.size() <= 80
        && request.resource.data.guardianName is string && request.resource.data.guardianName.size() > 0 && request.resource.data.guardianName.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 30
        && request.resource.data.consentKvkk == true
        && request.resource.data.status == 'new'
        && optStr('kidDob', 20) && optStr('area', 20) && optStr('school', 80) && optStr('relation', 30)
        && optStr('phone2', 30) && optStr('email', 80) && optStr('health', 500) && optStr('note', 500) && optStr('dateStr', 20)
        && (!('docs' in request.resource.data) || (request.resource.data.docs is list && request.resource.data.docs.size() <= 12));
      allow read, update, delete: if isRegistrar();
    }

    // Veli kaydı (doc id = veli no)
    match /guardians/{no} {
      allow read:  if kidRead() || (isGuardian() && prefix() == no);
      allow write: if isRegistrar();
    }

    // Çocuk kaydı — veli yalnızca izin/teslim/sağlık alanlarını güncelleyebilir
    match /kids/{id} {
      allow read:   if kidRead() || myKid(resource.data);
      allow create, delete: if isRegistrar();
      allow update: if isRegistrar()
        || (myKid(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pickups','consentPhoto','consentShare','health','updatedAt']));
    }

    // Giriş/çıkış yoklaması (öğretmen/öğrenci işleri yazar, veli okur)
    match /kidAttendance/{id} {
      allow read:  if kidRead() || myKid(resource.data);
      // Yönetici ve Öğrenci İşleri çocuk yoklaması YAZAMAZ: yalnız çocuk öğretmenleri (ve çocuk akademisine bağlı sorumlu-öğretmenler)
      allow write: if kidTeach();
    }

    // Çocuk akademisi programı: yönetici her dersi; çocuk akademisi bölüm sorumlusu yalnız KENDİ dersinin (alan)
    // haftalık derslerini; Öğrenci İşleri yalnız atölye dersini (ws_<sınıf>).
    function kidHeadSchedWrite() {
      return kidHeadLvl() && request.resource.data.get('area', '') == headArea()
        && (resource == null || resource.data.get('area', '') == headArea());
    }
    match /kidSchedule/{id} {
      allow read: if kidRead() || isGuardian();
      allow create, update: if isAdmin() || kidHeadSchedWrite();
      allow delete: if isAdmin() || (kidHeadLvl() && resource.data.get('area', '') == headArea());
    }
    // Günlük görevlendirme (çocuk akademisi): dersin sorumlusu belirli bir tarih için başka çocuk öğretmenini / kendini görevlendirir
    function kidSchedPath(lf) { return /databases/$(database)/documents/kidSchedule/$(lf); }
    match /kidSubs/{id} {
      allow read: if kidRead();
      allow create, update: if kidHeadLvl() && request.resource.data.keys().hasOnly(['lessonFire', 'date', 'teacherNo', 'teacherName', 'area', 'byNo', 'updatedAt'])
        && id == request.resource.data.get('lessonFire', '') + '_' + request.resource.data.get('date', '')
        && request.resource.data.get('teacherNo', '') is string && request.resource.data.get('teacherNo', '') != ''
        && exists(kidSchedPath(request.resource.data.get('lessonFire', '')))
        && get(kidSchedPath(request.resource.data.get('lessonFire', ''))).data.get('area', '') == headArea();
      allow delete: if kidHeadLvl() && exists(kidSchedPath(resource.data.get('lessonFire', '')))
        && get(kidSchedPath(resource.data.get('lessonFire', ''))).data.get('area', '') == headArea();
    }
    // Sınıflar (1., 2., …): çocuğun sınıfı kids.classLevel; sınıf öğretmeni burada (doc id = L<seviye>)
    // Çocuk sınıfları: çocuk akademisi bölüm sorumlusu KENDİ bölümünün sınıflarını açar / sınıf öğretmeni atar; yönetici hepsini.
    // Öğrenci İşleri sınıf yönetmez (yalnız kayıt, başvuru, kart).
    function kidHeadClassOk(d) { return kidHeadLvl() && d.get('kind', '') == 'area' && d.get('area', '') == headArea(); }
    match /kidClasses/{id} {
      allow read: if kidRead() || isGuardian();
      allow create: if isAdmin() || kidHeadClassOk(request.resource.data);
      allow update: if isAdmin() || (kidHeadClassOk(resource.data) && kidHeadClassOk(request.resource.data));
      allow delete: if isAdmin() || kidHeadClassOk(resource.data);
    }
    // Çocuk Akademisi anketleri kaldırıldı: okuma/yazma kapalı
    match /kidSurveys/{id}         { allow read, write: if false; }
    match /kidSurveyResponses/{id} { allow read, write: if false; }
    // Çocuk akademisi bölüm sorumlusu kendi bölümünün sınıflarına duyuru / ödev / belge yazar (önce denenir)
    function kidHeadClassPostOk() {
      let d = request.resource.data;
      return kidHeadLvl() && d.teacherNo == prefix() && d.classId is string
        && d.title is string && d.title.size() > 0 && d.title.size() <= 140
        && d.type in ['duyuru', 'odev', 'belge']
        && (!('studentNos' in d) || (d.studentNos is list && d.studentNos.size() >= 1 && d.studentNos.size() <= 60))
        && exists(clsDoc('kidClasses', d.classId)) && kidHeadClassOk(get(clsDoc('kidClasses', d.classId)).data);
    }
    match /kidClassPosts/{id} {
      allow read: if kidRead() || isGuardian();
      allow create: if kidHeadClassPostOk() || isRegistrar() || (kidStaff() && classPostOk('kidClasses', 'kidSchedule'));
      allow update: if isRegistrar();
      allow delete: if isRegistrar() || (kidStaff() && resource.data.teacherNo == prefix());
    }
    // Duyuru: çocuk akademisi bölüm sorumlusu YALNIZCA kendi bölümüne, kendi adıyla
    function kidHeadAnnOk(d) { return kidHeadLvl() && d.get('byNo', '') == prefix() && d.get('area', '') == headArea(); }
    // Çocuk öğretmeni genel duyuru YAZAMAZ: yalnızca kendi sınıflarına (kidClassPosts type "duyuru")
    match /kidAnnouncements/{id} {
      allow read: if kidRead() || isGuardian();
      allow create: if isRegistrar() || kidHeadAnnOk(request.resource.data);
      allow update: if isRegistrar() || (kidHeadAnnOk(resource.data) && kidHeadAnnOk(request.resource.data));
      allow delete: if isRegistrar() || kidHeadAnnOk(resource.data);
    }
    // Eski haftalık değerlendirme (Çocuk Akademisi) KALDIRILDI: değerlendirme yalnız sorumlunun formlarıyla (evalResponses t2k / g2t).
    // Kalan eski veriler temizlik iş akışıyla silinir; kimse yazamaz, yalnız yönetici okur/siler.
    function kidTeach() { return isKidTeacher() || (isStaff() && exists(dbPath('idx_kidstaff'))); }
    match /kidEvals/{id}        { allow read, delete: if isAdmin(); allow create, update: if false; }
    match /kidTeacherEvals/{id} { allow read, delete: if isAdmin(); allow create, update: if false; }

    // Anlık bildirim cihaz kayıtları: herkes yalnızca KENDİ cihazını, KENDİ numarası ve rolüyle kaydeder.
    // Okuma/silme yalnızca sahibi; gönderimi sunucu (Cloud Functions) yapar.
    function pushRoleOk(r) {
      return (isStudent() && r == 'student')
        // personel rolü dizindeki seviyeyle AYNI olmalı (öğretmen kendini "sorumlu"/"yönetici" diye kaydedip
        // onların bildirimlerini alamaz); sorumlunun bölümü de dizindeki bölüm olmalı
        || (isStaff() && (r == 'teacher'
            || (r == 'admin' && isAdmin())
            || (r in ['registrar', 'press', 'head'] && mail() != 'admin@aramtigran.edu'
                && get(dbPath('idx_staff')).data.get('lvl', 'teacher') == r
                && (r != 'head' || string(request.resource.data.get('area', '')) == headArea()))))
        || (isGuardian() && r == 'guardian')
        || (kidStaff() && r == 'kidteacher');
    }
    match /pushTokens/{t} {
      allow read, delete: if authed() && resource.data.uid == request.auth.uid;
      allow create, update: if authed()
        && request.resource.data.keys().hasOnly(['uid', 'no', 'role', 'app', 'lang', 'area', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && string(request.resource.data.no) == prefix()
        && request.resource.data.app in ['aat', 'zarok']
        && pushRoleOk(request.resource.data.role)
        && (resource == null || resource.data.uid == request.auth.uid);
    }

    // Veli ↔ akademi mesajları
    match /kidMessages/{id} {
      allow read: if kidRead() || (isGuardian() && resource.data.guardianNo == prefix());
      allow create: if kidStaff()
        // Çocuk akademisi bölüm sorumlusu veliye cevap yazar (kendi adıyla, kayıtlı veliye)
        || (kidHeadLvl()
            && request.resource.data.keys().hasOnly(['guardianNo','guardianName','text','from','by','byNo','read','createdAt'])
            && request.resource.data.from == 'staff' && request.resource.data.byNo == prefix()
            && exists(/databases/$(database)/documents/guardians/$(request.resource.data.guardianNo))
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000)
        || (isGuardian()
            && request.resource.data.keys().hasOnly(['guardianNo','guardianName','kidId','kidName','text','from','read','createdAt','toTeacherNo','toName'])
            && request.resource.data.guardianNo == prefix()
            && request.resource.data.get('toTeacherNo', '') is string && request.resource.data.get('toName', '') is string
            && request.resource.data.from == 'guardian'
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000);
      allow update: if kidStaff()
        || (kidHeadLvl() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isRegistrar();
    }

    // ════════════════════════════════════════════════════════════════════
    //  ÖĞRENCİ KARTLARI (yetişkin + çocuk) — QR içinde tahmin edilemez anahtar (128 bit)
    //    cards/{token}: {kind:'student'|'kid', no, ref, name, area, photo, active}
    //    • Anahtarı bilen (kartı elinde tutan) yetkili okutur; LİSTELENEMEZ (tahmin/tarama yok)
    //    • Yalnızca öğrenci işleri + yönetici kart çıkarır / iptal eder
    // ════════════════════════════════════════════════════════════════════
    match /cards/{token} {
      allow get:  if staffW() || isGate() || (aatHead() && resource.data.kind == 'student') || ((isKidTeacher() || (kidHeadLvl() && exists(dbPath('idx_kidstaff')))) && resource.data.kind == 'kid');
      allow list: if isRegistrar();
      allow create, update, delete: if isRegistrar();
    }
    // Kapı / ders girişi kaydı — okutan kişi kendi numarasıyla yazar; değiştirilemez, silinemez
    match /gateLog/{id} {
      allow create: if (isGate() || staffW() || isKidTeacher() || aatHead() || (kidHeadLvl() && exists(dbPath('idx_kidstaff'))))
        && request.resource.data.keys().hasOnly(['token','no','kind','name','ok','by','byName','at','date','place'])
        && request.resource.data.by == prefix()
        && request.resource.data.date is string && request.resource.data.date.size() <= 10
        && request.resource.data.get('place', 'gate') in ['gate', 'lesson'];
      allow read: if isRegistrar() || ((isGate() || isStaff() || isKidTeacher()) && resource.data.by == prefix());
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
